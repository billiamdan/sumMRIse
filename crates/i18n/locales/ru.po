msgid "Turn the picture a quarter turn to the right"
msgstr "Повернуть изображение на четверть оборота вправо"

#: crates/ui/src/orient.rs
msgid "Rotate right"
msgstr "Повернуть вправо"

#: crates/ui/src/orient.rs
