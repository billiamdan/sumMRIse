#: crates/core/src/documents/pdf.rs
msgid "It is protected by a password."
msgstr "Он защищён паролем."

#: crates/core/src/documents/pdf.rs
msgid "It is damaged or uses a feature that is not supported."
msgstr "Он повреждён или использует неподдерживаемую функцию."

#: crates/core/src/documents.rs
msgid "Reading this document failed unexpectedly."
msgstr "При чтении этого документа произошла непредвиденная ошибка."

#: crates/core/src/export.rs
msgid "PNG (no loss of quality)"
msgstr "PNG (без потери качества)"

#: crates/core/src/export.rs
#: crates/ui/src/export.rs
msgid "Exporting images"
msgstr "Экспорт изображений"

#: crates/core/src/guide.rs
msgid "General information about how these images were made, not an interpretation of the images."
msgstr "Общие сведения о том, как были получены эти изображения, а не их интерпретация."

#: crates/core/src/guide.rs
msgid "The settings are read from one image of the series; other images of the series may differ."
msgstr "Параметры взяты из одного изображения серии; у других изображений серии они могут отличаться."

#: crates/core/src/guide.rs
msgid "Named by the scanner operator: the series description reads “{name}”."
msgstr "Название дано оператором аппарата: описание серии — «{name}»."

#: crates/core/src/guide.rs
msgid "Named by the scanner operator: the protocol name reads “{name}”."
msgstr "Название дано оператором аппарата: протокол называется «{name}»."

#: crates/core/src/guide.rs
msgid "Recorded in the images: image type LOCALIZER."
msgstr "Указано в изображениях: тип изображения LOCALIZER."

#: crates/core/src/guide.rs
msgid "For this kind of sequence the recorded timing does not settle the weighting."
msgstr "Для такой последовательности указанные временные параметры не позволяют однозначно определить взвешенность."

#: crates/core/src/guide.rs
msgid "No repetition time or echo time is recorded."
msgstr "Время повторения и время эха не указаны."

#: crates/core/src/guide.rs
msgid "The images do not record which type of sequence was used."
msgstr "В изображениях не указано, какой тип последовательности использовался."

#: crates/core/src/guide.rs
msgid "Inferred from the recorded settings: a gradient-echo sequence with a long echo time ({te} ms) and a small flip angle ({flip} degrees)."
msgstr "Выведено из указанных параметров: последовательность градиентного эха с длинным временем эха ({te} ms) и малым углом отклонения ({flip}°)."

#: crates/core/src/guide.rs
msgid "For this gradient-echo sequence the recorded timing does not settle the weighting."
msgstr "Для этой последовательности градиентного эха указанные временные параметры не позволяют однозначно определить взвешенность."

#: crates/core/src/guide.rs
msgid "An inversion pulse is recorded, but not its timing."
msgstr "Инвертирующий импульс указан, но его время — нет."

#: crates/core/src/guide.rs
msgid "Inferred from the recorded timing: repetition time {tr} ms and a short inversion time ({ti} ms), which suppresses the signal of fat."
msgstr "Выведено из указанных временных параметров: время повторения {tr} ms и короткое время инверсии ({ti} ms), при котором подавляется сигнал жира."

#: crates/core/src/guide.rs
msgid "Inferred from the recorded timing: long repetition time ({tr} ms), long echo time ({te} ms) and a long inversion time ({ti} ms), which suppresses the signal of fluid."
msgstr "Выведено из указанных временных параметров: длинное время повторения ({tr} ms), длинное время эха ({te} ms) и длинное время инверсии ({ti} ms), при котором подавляется сигнал жидкости."

#: crates/core/src/guide.rs
msgid "An inversion time of {ti} ms fits none of the rules this guide uses."
msgstr "Время инверсии {ti} ms не подходит ни под одно из правил этого справочника."

#: crates/core/src/guide.rs
msgid "Inferred from the recorded timing: short repetition time ({tr} ms) and short echo time ({te} ms)."
msgstr "Выведено из указанных временных параметров: короткое время повторения ({tr} ms) и короткое время эха ({te} ms)."

#: crates/core/src/guide.rs
msgid "Inferred from the recorded timing: long repetition time ({tr} ms) and long echo time ({te} ms)."
msgstr "Выведено из указанных временных параметров: длинное время повторения ({tr} ms) и длинное время эха ({te} ms)."

#: crates/core/src/guide.rs
msgid "Inferred from the recorded timing: long repetition time ({tr} ms) and short echo time ({te} ms)."
msgstr "Выведено из указанных временных параметров: длинное время повторения ({tr} ms) и короткое время эха ({te} ms)."

#: crates/core/src/guide.rs
msgid "Repetition time {tr} ms and echo time {te} ms fit none of the rules this guide uses."
msgstr "Время повторения {tr} ms и время эха {te} ms не подходят ни под одно из правил этого справочника."

#: crates/core/src/guide.rs
msgid "Recorded in the images: image type ADC."
msgstr "Указано в изображениях: тип изображения ADC."

#: crates/core/src/guide.rs
msgid "Recorded in the images: diffusion b-value {b} s/mm²."
msgstr "Указано в изображениях: b-значение диффузии {b} s/mm²."

#: crates/core/src/guide.rs
msgid "Recorded in the images: image type DIFFUSION."
msgstr "Указано в изображениях: тип изображения DIFFUSION."

#: crates/core/src/guide.rs
msgid "MR scan"
msgstr "МРТ"

#: crates/core/src/guide.rs
msgid "MR scan, T1-weighted"
msgstr "МРТ, T1-взвешенная"

#: crates/core/src/guide.rs
msgid "MR scan, likely T1-weighted"
msgstr "МРТ, вероятно T1-взвешенная"

#: crates/core/src/guide.rs
msgid "MR scan, T2-weighted"
msgstr "МРТ, T2-взвешенная"

#: crates/core/src/guide.rs
msgid "MR scan, likely T2-weighted"
msgstr "МРТ, вероятно T2-взвешенная"

#: crates/core/src/guide.rs
msgid "MR scan, proton-density-weighted"
msgstr "МРТ, взвешенная по протонной плотности"

#: crates/core/src/guide.rs
msgid "MR scan, likely proton-density-weighted"
msgstr "МРТ, вероятно взвешенная по протонной плотности"

#: crates/core/src/guide.rs
msgid "MR scan, T2*-weighted"
msgstr "МРТ, T2*-взвешенная"

#: crates/core/src/guide.rs
msgid "MR scan, likely T2*-weighted"
msgstr "МРТ, вероятно T2*-взвешенная"

#: crates/core/src/guide.rs
msgid "MR scan, T2 FLAIR (fluid suppressed)"
msgstr "МРТ, T2 FLAIR (подавление жидкости)"

#: crates/core/src/guide.rs
msgid "MR scan, likely T2 FLAIR (fluid suppressed)"
msgstr "МРТ, вероятно T2 FLAIR (подавление жидкости)"

#: crates/core/src/guide.rs
msgid "MR scan, T1 FLAIR (fluid suppressed)"
msgstr "МРТ, T1 FLAIR (подавление жидкости)"

#: crates/core/src/guide.rs
msgid "MR scan, STIR (fat suppressed)"
msgstr "МРТ, STIR (подавление жира)"

#: crates/core/src/guide.rs
msgid "MR scan, likely STIR (fat suppressed)"
msgstr "МРТ, вероятно STIR (подавление жира)"

#: crates/core/src/guide.rs
msgid "MR scan, diffusion-weighted"
msgstr "МРТ, диффузионно-взвешенная"

#: crates/core/src/guide.rs
msgid "MR scan, ADC map (calculated)"
msgstr "МРТ, карта ADC (расчётная)"

#: crates/core/src/guide.rs
msgid "The weighting of these images cannot be told from what is recorded."
msgstr "Взвешенность этих изображений нельзя определить по указанным в них данным."

#: crates/core/src/guide.rs
msgid "T1-weighted: on such images fat tends to appear bright and fluid dark."
msgstr "T1-взвешенные: на таких изображениях жир обычно выглядит ярким, а жидкость — тёмной."

#: crates/core/src/guide.rs
msgid "Likely T1-weighted: on such images fat tends to appear bright and fluid dark."
msgstr "Вероятно, T1-взвешенные: на таких изображениях жир обычно выглядит ярким, а жидкость — тёмной."

#: crates/core/src/guide.rs
msgid "T2-weighted: on such images fluid tends to appear bright."
msgstr "T2-взвешенные: на таких изображениях жидкость обычно выглядит яркой."

#: crates/core/src/guide.rs
msgid "Likely T2-weighted: on such images fluid tends to appear bright."
msgstr "Вероятно, T2-взвешенные: на таких изображениях жидкость обычно выглядит яркой."

#: crates/core/src/guide.rs
msgid "Proton-density-weighted: on such images brightness mainly follows how much water and fat a tissue contains, so fluid and fat both appear fairly bright."
msgstr "Взвешенные по протонной плотности: на таких изображениях яркость в основном зависит от того, сколько воды и жира содержит ткань, поэтому и жидкость, и жир выглядят довольно яркими."

#: crates/core/src/guide.rs
msgid "Likely proton-density-weighted: on such images brightness mainly follows how much water and fat a tissue contains, so fluid and fat both appear fairly bright."
msgstr "Вероятно, взвешенные по протонной плотности: на таких изображениях яркость в основном зависит от того, сколько воды и жира содержит ткань, поэтому и жидкость, и жир выглядят довольно яркими."

#: crates/core/src/guide.rs
msgid "T2*-weighted: such images are very sensitive to small disturbances of the magnetic field; places where the field is disturbed, for example next to air, tend to appear dark."
msgstr "T2*-взвешенные: такие изображения очень чувствительны к небольшим искажениям магнитного поля; места, где поле искажено, например рядом с воздухом, обычно выглядят тёмными."

#: crates/core/src/guide.rs
msgid "Likely T2*-weighted: such images are very sensitive to small disturbances of the magnetic field; places where the field is disturbed, for example next to air, tend to appear dark."
msgstr "Вероятно, T2*-взвешенные: такие изображения очень чувствительны к небольшим искажениям магнитного поля; места, где поле искажено, например рядом с воздухом, обычно выглядят тёмными."

#: crates/core/src/guide.rs
msgid "T2 FLAIR: like a T2-weighted image, but the signal of free fluid is suppressed, so fluid such as that around the brain appears dark."
msgstr "T2 FLAIR: как T2-взвешенное изображение, но сигнал свободной жидкости подавлен, поэтому жидкость, например вокруг мозга, выглядит тёмной."

#: crates/core/src/guide.rs
msgid "Likely T2 FLAIR: like a T2-weighted image, but the signal of free fluid is suppressed, so fluid such as that around the brain appears dark."
msgstr "Вероятно, T2 FLAIR: как T2-взвешенное изображение, но сигнал свободной жидкости подавлен, поэтому жидкость, например вокруг мозга, выглядит тёмной."

#: crates/core/src/guide.rs
msgid "T1 FLAIR: a T1-weighted image made with an extra preparation pulse that suppresses the signal of free fluid, which appears dark."
msgstr "T1 FLAIR: T1-взвешенное изображение, полученное с дополнительным подготовительным импульсом, который подавляет сигнал свободной жидкости; она выглядит тёмной."

#: crates/core/src/guide.rs
msgid "STIR: the signal of fat is suppressed and appears dark, while fluid tends to appear bright."
msgstr "STIR: сигнал жира подавлен, и жир выглядит тёмным, а жидкость обычно выглядит яркой."

#: crates/core/src/guide.rs
msgid "Likely STIR: the signal of fat is suppressed and appears dark, while fluid tends to appear bright."
msgstr "Вероятно, STIR: сигнал жира подавлен, и жир выглядит тёмным, а жидкость обычно выглядит яркой."

#: crates/core/src/guide.rs
msgid "Diffusion-weighted: such images are sensitive to how freely water molecules move in the tissue; where they move less freely, the image tends to be brighter."
msgstr "Диффузионно-взвешенные: такие изображения чувствительны к тому, насколько свободно движутся молекулы воды в ткани; там, где их движение затруднено, изображение обычно ярче."

#: crates/core/src/guide.rs
msgid "ADC map: an image calculated from diffusion-weighted images, not measured directly; brighter means that water moves more freely."
msgstr "Карта ADC: изображение, рассчитанное по диффузионно-взвешенным изображениям, а не измеренное напрямую; чем ярче, тем свободнее движется вода."

#: crates/core/src/guide.rs
msgid "CT scan"
msgstr "КТ"

#: crates/core/src/guide.rs
msgid "Localizer (planning overview)"
msgstr "Обзорный снимок (планирование)"

#: crates/core/src/guide.rs
msgid "Dose report (a stored picture)"
msgstr "Снимок отчёта о дозе"

#: crates/core/src/guide.rs
msgid "Stored picture (secondary capture)"
msgstr "Сохранённое изображение (вторичный захват)"

#: crates/core/src/guide.rs
msgid "PET scan"
msgstr "ПЭТ"

#: crates/core/src/guide.rs
msgid "Nuclear medicine image"
msgstr "Радионуклидное исследование"

#: crates/core/src/guide.rs
msgid "Ultrasound image"
msgstr "УЗИ"

#: crates/core/src/guide.rs
msgid "X-ray image"
msgstr "Рентгеновский снимок"

#: crates/core/src/guide.rs
msgid "Mammogram (X-ray image)"
msgstr "Маммограмма (рентгеновский снимок)"

#: crates/core/src/guide.rs
msgid "X-ray fluoroscopy or angiography"
msgstr "Рентгеноскопия или ангиография"

#: crates/core/src/guide.rs
msgid "Unrecognised kind of images"
msgstr "Неизвестный вид изображений"

#: crates/core/src/guide.rs
msgid "A CT scan (computed tomography) measures with X-rays from many directions and computes cross-sections of the body from them. On the usual display, denser means brighter: bone is bright, air is dark."
msgstr "При КТ (компьютерной томографии) тело просвечивают рентгеновскими лучами со многих направлений и по этим измерениям вычисляют поперечные срезы тела. При обычном отображении чем плотнее ткань, тем она ярче: кость яркая, воздух тёмный."

#: crates/core/src/guide.rs
msgid "An MR scan (magnetic resonance imaging) is made with a strong magnet and radio waves, without X-rays. Which tissues appear bright depends on the settings of each series."
msgstr "МРТ (магнитно-резонансная томография) выполняется с помощью сильного магнита и радиоволн, без рентгеновского излучения. Какие ткани выглядят яркими, зависит от параметров каждой серии."

#: crates/core/src/guide.rs
msgid "A localizer (also called scout or survey): quick overview images that the operator uses to plan the other series. They are coarse on purpose."
msgstr "Обзорные снимки (локалайзер, скаут): быстрые обзорные изображения, по которым оператор планирует остальные серии. Их низкая детализация — намеренная."

#: crates/core/src/guide.rs
msgid "A picture of the dose report: a table of the radiation dose values that the scanner recorded for this examination. It is a stored picture, not a scan of the body."
msgstr "Изображение отчёта о дозе: таблица значений дозы облучения, которые аппарат записал для этого исследования. Это сохранённое изображение, а не снимок тела."

#: crates/core/src/guide.rs
msgid "A stored picture (secondary capture), such as a screenshot, a computed 3D view or a scanned document. It was produced by a workstation or by the scanner software, not measured directly."
msgstr "Сохранённое изображение (вторичный захват), например снимок экрана, вычисленный 3D-вид или отсканированный документ. Оно создано рабочей станцией или программой аппарата, а не измерено напрямую."

#: crates/core/src/guide.rs
msgid "A PET scan (positron emission tomography) shows where a weakly radioactive tracer has collected in the body."
msgstr "ПЭТ (позитронно-эмиссионная томография) показывает, где в теле накопился введённый слаборадиоактивный препарат (радиофармпрепарат)."

#: crates/core/src/guide.rs
msgid "A nuclear medicine image shows where a weakly radioactive tracer has collected in the body, recorded by a gamma camera."
msgstr "Радионуклидное изображение показывает, где в теле накопился введённый слаборадиоактивный препарат; его излучение регистрирует гамма-камера."

#: crates/core/src/guide.rs
msgid "An ultrasound image is made with sound waves that the tissues reflect, without X-rays."
msgstr "Ультразвуковое изображение получают с помощью звуковых волн, которые отражаются от тканей, без рентгеновского излучения."

#: crates/core/src/guide.rs
msgid "An X-ray image (projection): X-rays pass through the body onto a detector, so structures lying behind each other overlap in one picture."
msgstr "Рентгеновский снимок (проекция): рентгеновские лучи проходят через тело на детектор, поэтому структуры, лежащие одна за другой, накладываются друг на друга на одном снимке."

#: crates/core/src/guide.rs
msgid "A mammogram: an X-ray projection image of the breast."
msgstr "Маммограмма: рентгеновский проекционный снимок молочной железы."

#: crates/core/src/guide.rs
msgid "X-ray fluoroscopy or angiography: X-ray projection images, often recorded as a moving sequence, for example while a contrast agent flows through vessels."
msgstr "Рентгеноскопия или ангиография: рентгеновские проекционные изображения, часто записанные как движущаяся последовательность, например пока контрастное вещество проходит по сосудам."

#: crates/core/src/guide.rs
msgid "This guide does not recognise what kind of images these are."
msgstr "Этот справочник не может определить, что это за изображения."

#: crates/core/src/guide.rs
msgid "The files are stored pictures and the series description reads “{name}”."
msgstr "Файлы являются сохранёнными изображениями, а описание серии — «{name}»."

#: crates/core/src/guide.rs
msgid "Recorded in the images: the files are secondary captures."
msgstr "Указано в изображениях: файлы являются вторичными захватами."

#: crates/core/src/guide.rs
msgid "Recorded in the images: modality {modality}."
msgstr "Указано в изображениях: модальность {modality}."

#: crates/core/src/guide.rs
msgid "The slices are axial: horizontal cross-sections of the body, like the slices of a loaf of bread."
msgstr "Срезы аксиальные: горизонтальные поперечные срезы тела, как ломтики нарезанного хлеба."

#: crates/core/src/guide.rs
msgid "The slices are coronal: they divide the body into front and back, like a view from the front."
msgstr "Срезы корональные: они делят тело на переднюю и заднюю части, как при взгляде спереди."

#: crates/core/src/guide.rs
msgid "The slices are sagittal: they divide the body into left and right, like a view from the side."
msgstr "Срезы сагиттальные: они делят тело на левую и правую части, как при взгляде сбоку."

#: crates/core/src/guide.rs
msgid "The slices are tilted (oblique): they lie between the standard directions."
msgstr "Срезы наклонные (косые): они лежат между стандартными направлениями."

#: crates/core/src/guide.rs
msgid "The images of this series lie in different directions."
msgstr "Изображения этой серии лежат в разных направлениях."

#: crates/core/src/guide.rs
msgid "This series holds {n} time point of the same slices."
msgid_plural "This series holds {n} time points of the same slices."
msgstr[0] "Эта серия содержит {n} временную точку одних и тех же срезов."
msgstr[1] "Эта серия содержит {n} временные точки одних и тех же срезов."
msgstr[2] "Эта серия содержит {n} временных точек одних и тех же срезов."

#: crates/core/src/guide.rs
msgid "Recorded in the images: temporal position."
msgstr "Указано в изображениях: временная позиция."

#: crates/core/src/guide.rs
msgid "This series holds {n} phase of the heartbeat at the same slices."
msgid_plural "This series holds {n} phases of the heartbeat at the same slices."
msgstr[0] "Эта серия содержит {n} фазу сердечного цикла на одних и тех же срезах."
msgstr[1] "Эта серия содержит {n} фазы сердечного цикла на одних и тех же срезах."
msgstr[2] "Эта серия содержит {n} фаз сердечного цикла на одних и тех же срезах."

#: crates/core/src/guide.rs
msgid "Recorded in the images: trigger time."
msgstr "Указано в изображениях: время триггера."

#: crates/core/src/guide.rs
msgid "This series holds {n} echo of the same slices: images taken at different echo times."
msgid_plural "This series holds {n} echoes of the same slices: images taken at different echo times."
msgstr[0] "Эта серия содержит {n} эхо одних и тех же срезов: изображения, полученные при разном времени эха."
msgstr[1] "Эта серия содержит {n} эхо одних и тех же срезов: изображения, полученные при разном времени эха."
msgstr[2] "Эта серия содержит {n} эхо одних и тех же срезов: изображения, полученные при разном времени эха."

#: crates/core/src/guide.rs
msgid "Recorded in the images: echo number and echo time."
msgstr "Указано в изображениях: номер эха и время эха."

#: crates/core/src/guide.rs
msgid "This series holds {n} diffusion weighting (b-value) of the same slices."
msgid_plural "This series holds {n} diffusion weightings (b-values) of the same slices."
msgstr[0] "Эта серия содержит {n} диффузионное взвешивание (b-значение) одних и тех же срезов."
msgstr[1] "Эта серия содержит {n} диффузионных взвешивания (b-значения) одних и тех же срезов."
msgstr[2] "Эта серия содержит {n} диффузионных взвешиваний (b-значений) одних и тех же срезов."

#: crates/core/src/guide.rs
msgid "Recorded in the images: diffusion b-value."
msgstr "Указано в изображениях: b-значение диффузии."

#: crates/core/src/guide.rs
msgid "This series holds {n} kind of image of the same slices."
msgid_plural "This series holds {n} kinds of image of the same slices."
msgstr[0] "Эта серия содержит {n} вид изображений одних и тех же срезов."
msgstr[1] "Эта серия содержит {n} вида изображений одних и тех же срезов."
msgstr[2] "Эта серия содержит {n} видов изображений одних и тех же срезов."

#: crates/core/src/guide.rs
msgid "Recorded in the images: image type."
msgstr "Указано в изображениях: тип изображения."

#: crates/core/src/guide.rs
msgid "This series holds {n} acquisition of the same slices."
msgid_plural "This series holds {n} acquisitions of the same slices."
msgstr[0] "Эта серия содержит {n} измерение одних и тех же срезов."
msgstr[1] "Эта серия содержит {n} измерения одних и тех же срезов."
msgstr[2] "Эта серия содержит {n} измерений одних и тех же срезов."

#: crates/core/src/guide.rs
msgid "Recorded in the images: acquisition number."
msgstr "Указано в изображениях: номер измерения."

#: crates/core/src/guide.rs
msgid "This series holds {n} set of the same slices, made with a different sequence."
msgid_plural "This series holds {n} sets of the same slices, made with different sequences."
msgstr[0] "Эта серия содержит {n} набор одних и тех же срезов, полученных разными последовательностями."
msgstr[1] "Эта серия содержит {n} набора одних и тех же срезов, полученных разными последовательностями."
msgstr[2] "Эта серия содержит {n} наборов одних и тех же срезов, полученных разными последовательностями."

#: crates/core/src/guide.rs
msgid "Recorded in the images: sequence name."
msgstr "Указано в изображениях: название последовательности."

#: crates/core/src/guide.rs
msgid "This series holds {n} set of images of the same slices."
msgid_plural "This series holds {n} sets of images of the same slices."
msgstr[0] "Эта серия содержит {n} набор изображений одних и тех же срезов."
msgstr[1] "Эта серия содержит {n} набора изображений одних и тех же срезов."
msgstr[2] "Эта серия содержит {n} наборов изображений одних и тех же срезов."

#: crates/core/src/guide.rs
msgid "The images repeat the same slice positions, and nothing recorded in them tells the sets apart."
msgstr "Изображения повторяют одни и те же положения срезов, и ничто из указанного в них не позволяет различить наборы."

#: crates/core/src/guide.rs
msgid "The images were measured slice by slice (2D)."
msgstr "Изображения измерены срез за срезом (2D)."

#: crates/core/src/guide.rs
msgid "A whole block of the body was measured at once (3D) and then divided into the slices shown."
msgstr "Целый блок тела был измерен сразу (3D), а затем разделён на показанные срезы."

#: crates/core/src/guide.rs
msgid "Recorded in the images: MR acquisition type."
msgstr "Указано в изображениях: тип сбора данных МР."

#: crates/core/src/guide.rs
msgid "No contrast agent is recorded for this series, which does not rule one out: not every scanner records it."
msgstr "Для этой серии контрастное вещество не указано, но это не исключает его применения: не каждый аппарат это записывает."

#: crates/core/src/guide.rs
msgid "The contrast agent entry of the images reads “{value}”."
msgstr "Запись о контрастном веществе в изображениях: «{value}»."

#: crates/core/src/guide.rs
msgid "A contrast agent is recorded for this series: {agent}."
msgstr "Для этой серии указано контрастное вещество: {agent}."

#: crates/core/src/guide.rs
msgid "Recorded in the images: contrast agent."
msgstr "Указано в изображениях: контрастное вещество."

#: crates/core/src/guide.rs
msgid "The contrast agent entry of the images is absent or empty."
msgstr "Запись о контрастном веществе в изображениях отсутствует или пуста."

#: crates/core/src/guide.rs
msgid "Recorded in the images: image orientation."
msgstr "Указано в изображениях: ориентация изображения."

#: crates/core/src/guide.rs
msgid "Each image shows a slice of the body {thickness} mm thick."
msgstr "Каждое изображение показывает срез тела толщиной {thickness} mm."

#: crates/core/src/guide.rs
msgid "Recorded in the images: slice thickness."
msgstr "Указано в изображениях: толщина среза."

#: crates/core/src/guide.rs
msgid "Computed with the reconstruction kernel “{kernel}”, as recorded by the scanner. The kernel sets the balance between sharp detail and low grain."
msgstr "Вычислено с ядром реконструкции «{kernel}», как указал аппарат. Ядро определяет баланс между чёткостью мелких деталей и низкой зернистостью."

#: crates/core/src/guide.rs
msgid "Recorded in the images: convolution kernel."
msgstr "Указано в изображениях: ядро реконструкции."

#: crates/core/src/guide.rs
msgid "The time between two successive excitations of the same slice, in milliseconds (ms, thousandths of a second). Together with the echo time it largely decides which tissues appear bright."
msgstr "Время между двумя последовательными возбуждениями одного и того же среза, в миллисекундах (ms, тысячных долях секунды). Вместе со временем эха оно во многом определяет, какие ткани выглядят яркими."

#: crates/core/src/guide.rs
msgid "The time between exciting the tissue and measuring its signal, in milliseconds (ms, thousandths of a second). With a long echo time, fluid stands out as bright."
msgstr "Время между возбуждением ткани и измерением её сигнала, в миллисекундах (ms, тысячных долях секунды). При длинном времени эха жидкость выглядит яркой."

#: crates/core/src/guide.rs
msgid "The waiting time after an extra preparation pulse, in milliseconds (ms, thousandths of a second). It is chosen so that the signal of one tissue, such as fat or fluid, is suppressed."
msgstr "Время ожидания после дополнительного подготовительного импульса, в миллисекундах (ms, тысячных долях секунды). Его выбирают так, чтобы подавить сигнал одной ткани, например жира или жидкости."

#: crates/core/src/guide.rs
msgid "How far the radio pulse tips the magnetisation of the tissue, in degrees. It influences brightness and contrast."
msgstr "Насколько радиоимпульс отклоняет намагниченность ткани, в градусах. Влияет на яркость и контраст."

#: crates/core/src/guide.rs
msgid "The number of echoes measured after each excitation. More echoes shorten the scan."
msgstr "Число эхо-сигналов, измеряемых после каждого возбуждения. Чем их больше, тем короче исследование."

#: crates/core/src/guide.rs
msgid "How many times each measurement was repeated and averaged. More averages give a less grainy image but take longer."
msgstr "Сколько раз каждое измерение повторяли и усредняли. Больше усреднений — менее зернистое изображение, но исследование длится дольше."

#: crates/core/src/guide.rs
msgid "The radio frequency the scanner worked at, in megahertz (MHz, millions of cycles per second). It follows from the strength of the magnet."
msgstr "Радиочастота, на которой работал аппарат, в мегагерцах (MHz, миллионах колебаний в секунду). Она зависит от силы магнита."

#: crates/core/src/guide.rs
msgid "The range of signal frequencies that falls into one pixel, in hertz per pixel (Hz/px). It affects image grain and some distortions."
msgstr "Диапазон частот сигнала, приходящийся на один пиксель, в герцах на пиксель (Hz/px). Влияет на зернистость изображения и некоторые искажения."

#: crates/core/src/guide.rs
msgid "The receiver coil, a kind of antenna placed near the body, that picked up the signal, as named by the scanner."
msgstr "Приёмная катушка — своего рода антенна рядом с телом, которая принимала сигнал; название дано аппаратом."

#: crates/core/src/guide.rs
msgid "The scanner's internal name of the measuring programme (pulse sequence). The names differ between manufacturers."
msgstr "Внутреннее название программы измерения (импульсной последовательности) в аппарате. Названия различаются у разных производителей."

#: crates/core/src/guide.rs
msgid "The basic measuring technique: spin echo, gradient echo, inversion recovery or echo planar. It shapes how tissues differ in brightness."
msgstr "Основная методика измерения: спиновое эхо, градиентное эхо, инверсия-восстановление или эхопланарная визуализация. Она определяет, как ткани различаются по яркости."

#: crates/core/src/guide.rs
msgid "Options of the measuring technique, recorded by the scanner as short codes, for example SP for spoiled or SK for segmented."
msgstr "Варианты методики измерения, записанные аппаратом короткими кодами, например SP — с подавлением остаточного сигнала (spoiled) или SK — сегментированная (segmented)."

#: crates/core/src/guide.rs
msgid "Further options used for the scan, recorded by the scanner as short codes, for example FS for fat suppression."
msgstr "Дополнительные опции исследования, записанные аппаратом короткими кодами, например FS — подавление жира."

#: crates/core/src/guide.rs
msgid "2D means the body was measured slice by slice. 3D means a whole block was measured at once and then divided into slices."
msgstr "2D означает, что тело измерялось срез за срезом. 3D означает, что целый блок был измерен сразу, а затем разделён на срезы."

#: crates/core/src/guide.rs
msgid "The strength of the scanner's main magnet, in tesla (T). Most scanners have 1.5 T or 3 T."
msgstr "Сила основного магнита томографа, в теслах (T). У большинства томографов 1.5 T или 3 T."

#: crates/core/src/guide.rs
msgid "The voltage of the X-ray tube, in kilovolts (kV, thousands of volts). It sets how penetrating the X-rays are."
msgstr "Напряжение рентгеновской трубки, в киловольтах (kV, тысячах вольт). Определяет проникающую способность рентгеновских лучей."

#: crates/core/src/guide.rs
msgid "The electric current through the X-ray tube, in milliamperes (mA, thousandths of an ampere). A higher current produces more X-rays: a less grainy image at a higher dose."
msgstr "Электрический ток через рентгеновскую трубку, в миллиамперах (mA, тысячных долях ампера). Больший ток даёт больше рентгеновского излучения: менее зернистое изображение при большей дозе."

#: crates/core/src/guide.rs
msgid "Tube current multiplied by exposure time, in milliampere-seconds (mAs). It is a measure of the amount of X-rays used for this image."
msgstr "Ток трубки, умноженный на время экспозиции, в миллиампер-секундах (mAs). Это мера количества рентгеновского излучения, использованного для этого изображения."

#: crates/core/src/guide.rs
msgid "How long the X-rays were on for this image, in milliseconds (ms, thousandths of a second)."
msgstr "Сколько времени было включено рентгеновское излучение для этого изображения, в миллисекундах (ms, тысячных долях секунды)."

#: crates/core/src/guide.rs
msgid "A standardised measure of the radiation output of the scanner for this scan, in milligray (mGy). It describes the scanner setting, not the dose an individual person received."
msgstr "Стандартизированная мера радиационного выхода аппарата для этого исследования, в миллигреях (mGy). Она описывает настройку аппарата, а не дозу, полученную конкретным человеком."

#: crates/core/src/guide.rs
msgid "The mathematical filter used to compute the images, as named by the scanner. Sharp kernels show fine detail and edges; smooth kernels reduce grain."
msgstr "Математический фильтр, с помощью которого вычислены изображения; название дано аппаратом. Резкие ядра показывают мелкие детали и края; мягкие уменьшают зернистость."

#: crates/core/src/guide.rs
msgid "The filter placed in the X-ray beam inside the scanner, as named by the manufacturer."
msgstr "Фильтр рентгеновского пучка внутри аппарата; название дано производителем."

#: crates/core/src/guide.rs
msgid "How far the table moves during one turn of the X-ray tube, relative to the width of the X-ray beam. At 1 the turns of the spiral lie side by side without gap or overlap."
msgstr "Насколько смещается стол за один оборот рентгеновской трубки относительно ширины рентгеновского пучка. При значении 1 витки спирали лежат вплотную, без промежутков и перекрытия."

#: crates/core/src/guide.rs
msgid "The time the X-ray tube needs for one turn around the body, in seconds (s)."
msgstr "Время, за которое рентгеновская трубка делает один оборот вокруг тела, в секундах (s)."

#: crates/core/src/guide.rs
msgid "The width of the X-ray beam along the body, in millimetres (mm)."
msgstr "Ширина рентгеновского пучка вдоль тела, в миллиметрах (mm)."

#: crates/core/src/guide.rs
msgid "The diameter of the circular area that was computed into the image, in millimetres (mm)."
msgstr "Диаметр круглой области, по которой вычислено изображение, в миллиметрах (mm)."

#: crates/core/src/guide.rs
msgid "The angle by which the scanner ring was tilted from the upright position, in degrees."
msgstr "Угол, на который кольцо томографа (гентри) было наклонено от вертикального положения, в градусах."

#: crates/core/src/guide.rs
msgid "The contrast agent recorded for this series. Contrast agents make vessels or certain tissues stand out in the images."
msgstr "Контрастное вещество, указанное для этой серии. Контрастные вещества делают сосуды или некоторые ткани заметнее на изображениях."

#: crates/core/src/guide.rs
msgid "The kind of equipment that made the images, for example CT (computed tomography) or MR (magnetic resonance)."
msgstr "Вид оборудования, на котором получены изображения, например CT (компьютерная томография) или MR (магнитно-резонансная томография)."

#: crates/core/src/guide.rs
msgid "The body region entered at the scanner for this series. It is picked from a list by the operator and can be imprecise."
msgstr "Область тела, указанная на аппарате для этой серии. Оператор выбирает её из списка, поэтому она может быть неточной."

#: crates/core/src/guide.rs
msgid "The name of the scan programme selected at the scanner. Hospitals choose these names themselves."
msgstr "Название программы исследования, выбранной на аппарате. Больницы сами выбирают эти названия."

#: crates/core/src/guide.rs
msgid "The name given to this series at the scanner, usually an abbreviation of the technique and the direction of the slices."
msgstr "Название этой серии на аппарате, обычно сокращённое обозначение методики и направления срезов."

#: crates/core/src/guide.rs
msgid "How the person lay in the scanner, for example head first and on the back."
msgstr "Как человек лежал в аппарате, например головой вперёд и на спине."

#: crates/core/src/guide.rs
msgid "The side of the body that was examined: R for right, L for left."
msgstr "Сторона тела, которую исследовали: R — правая, L — левая."

#: crates/core/src/guide.rs
msgid "The number under which the hospital's information system filed this examination."
msgstr "Номер, под которым информационная система больницы зарегистрировала это исследование."

#: crates/core/src/guide.rs
msgid "The number of this image within its series, as assigned by the scanner."
msgstr "Номер этого изображения в его серии, присвоенный аппаратом."

#: crates/core/src/guide.rs
msgid "Codes describing how the image came about, for example ORIGINAL for a direct measurement or DERIVED for an image computed from others."
msgstr "Коды, описывающие, как получено изображение, например ORIGINAL — прямое измерение, DERIVED — изображение, вычисленное из других."

#: crates/core/src/guide.rs
msgid "The number of picture points (pixels) across and down the image."
msgstr "Число точек изображения (пикселей) по ширине и по высоте."

#: crates/core/src/guide.rs
msgid "The number of images stored together in this file."
msgstr "Число изображений, хранящихся вместе в этом файле."

#: crates/core/src/guide.rs
msgid "The size of the piece of the body that one pixel stands for, in millimetres (mm): across by down."
msgstr "Размер участка тела, которому соответствует один пиксель, в миллиметрах (mm): по ширине и по высоте."

#: crates/core/src/guide.rs
msgid "The width and height of the area of the body that the image covers, in millimetres (mm)."
msgstr "Ширина и высота области тела, которую охватывает изображение, в миллиметрах (mm)."

#: crates/core/src/guide.rs
msgid "The thickness of the layer of the body shown in one image, in millimetres (mm). Thinner slices show finer detail but look grainier."
msgstr "Толщина части тела, показанной на одном изображении, в миллиметрах (mm). Более тонкие срезы показывают более мелкие детали, но выглядят зернистее."

#: crates/core/src/guide.rs
msgid "The distance from the middle of one slice to the middle of the next, in millimetres (mm). If it is larger than the slice thickness, there are gaps between the slices."
msgstr "Расстояние от середины одного среза до середины следующего, в миллиметрах (mm). Если оно больше толщины среза, между срезами есть промежутки."

#: crates/core/src/guide.rs
msgid "The position of this slice along the scan direction, in millimetres (mm), counted from a reference point set by the scanner."
msgstr "Положение этого среза вдоль направления сканирования, в миллиметрах (mm), отсчитанное от опорной точки, заданной аппаратом."

#: crates/core/src/guide.rs
msgid "Where the first pixel of this image lies in the body, in millimetres (mm): towards the patient's left, towards the back and towards the head, counted from a reference point set by the scanner."
msgstr "Где в теле лежит первый пиксель этого изображения, в миллиметрах (mm) от опорной точки, заданной аппаратом: в сторону левого бока пациента, в сторону спины и в сторону головы."

#: crates/core/src/guide.rs
msgid "The direction of the image through the body and the directions of its rows and columns. The letters stand for the patient's right (R), left (L), front (A), back (P), head (S) and feet (I)."
msgstr "Направление изображения в теле и направления его строк и столбцов. Буквы обозначают правую (R) и левую (L) сторону пациента, перед (A), спину (P), голову (S) и ноги (I)."

#: crates/core/src/guide.rs
msgid "How the stored numbers translate into grey levels or colours, for example MONOCHROME2: larger numbers are brighter."
msgstr "Как записанные числа переводятся в уровни серого или в цвета, например MONOCHROME2: чем больше число, тем ярче."

#: crates/core/src/guide.rs
msgid "How many bits hold each pixel value, which limits the number of different grey levels: 12 bits allow 4096 levels."
msgstr "Сколько битов отводится на значение каждого пикселя; это ограничивает число различных уровней серого: 12 бит дают 4096 уровней."

#: crates/core/src/guide.rs
msgid "The rule that turns stored numbers into meaningful values: stored number times slope plus intercept. For CT the result is in Hounsfield units (HU), a density scale on which water is 0 and air is -1000."
msgstr "Правило, по которому записанные числа переводятся в осмысленные величины: записанное число, умноженное на наклон, плюс сдвиг. Для КТ результат выражается в единицах Хаунсфилда (HU) — шкале плотности, на которой вода равна 0, а воздух -1000."

#: crates/core/src/guide.rs
msgid "Brightness and contrast settings stored with the image by the scanner or its operator. C is the centre and W the width of the range of values shown from black to white."
msgstr "Настройки яркости и контраста, сохранённые вместе с изображением аппаратом или оператором. C — центр, W — ширина диапазона значений, показанного от чёрного до белого."

#: crates/core/src/guide.rs
msgid "Whether the image was compressed in a way that discards some detail to save space."
msgstr "Было ли изображение сжато так, что часть деталей отброшена ради экономии места."

#: crates/core/src/guide.rs
msgid "Whether the equipment wrote text, such as names or dates, into the picture itself. Such text is part of the image and cannot be hidden by this viewer."
msgstr "Записало ли оборудование текст, например имена или даты, в само изображение. Такой текст — часть изображения, и эта программа не может его скрыть."

#: crates/core/src/guide.rs
msgid "The technical format in which the image data is stored in the file, including any compression."
msgstr "Технический формат, в котором данные изображения хранятся в файле, включая сжатие."

#: crates/core/src/guide.rs
msgid "The kind of DICOM object this file is, for example a CT image or a secondary capture, which is a stored picture."
msgstr "Вид объекта DICOM в этом файле, например изображение КТ или вторичный захват, то есть сохранённое изображение."

#: crates/core/src/guide.rs
msgid "A worldwide unique technical number of this examination. It has no medical meaning."
msgstr "Уникальный во всём мире технический номер этого исследования. Медицинского значения не имеет."

#: crates/core/src/guide.rs
msgid "A worldwide unique technical number of this series. It has no medical meaning."
msgstr "Уникальный во всём мире технический номер этой серии. Медицинского значения не имеет."

#: crates/core/src/guide.rs
msgid "A worldwide unique technical number of this image. It has no medical meaning."
msgstr "Уникальный во всём мире технический номер этого изображения. Медицинского значения не имеет."

#: crates/core/src/guide.rs
msgid "Images that share this number use the same coordinate system, so positions can be compared between them."
msgstr "Изображения с одинаковым номером используют одну и ту же систему координат, поэтому положения в них можно сравнивать."

#: crates/core/src/guide.rs
msgid "The standardised uptake value (SUV) compares the amount of tracer in a spot with the amount there would be if the injected tracer were spread evenly through the whole body, so 1 is that average. It is computed from the weight, the injected dose and the times that staff entered at the scanner, so it is approximate and only as exact as those entries."
msgstr "Стандартизированный уровень накопления (SUV) сравнивает количество радиофармпрепарата в участке тела с тем количеством, которое было бы там, если бы введённый препарат равномерно распределился по всему телу; таким образом, 1 — это среднее значение. Он вычисляется по весу, введённой дозе и времени, которые персонал ввёл на аппарате, поэтому он приблизителен и точен лишь настолько, насколько точны эти данные."

#: crates/core/src/guide.rs
msgid "The unit in which the scanner stored the values, for example BQML: becquerel per millilitre, the measured concentration of radioactivity."
msgstr "Единица, в которой аппарат записал значения, например BQML: беккерели на миллилитр, измеренная концентрация радиоактивности."

#: crates/core/src/guide.rs
msgid "Corrections the scanner applied to the values, as short codes: for example ATTN for attenuation, the weakening of the signal inside the body, and DECY for the decay of the radioactivity."
msgstr "Поправки, которые аппарат применил к значениям, в виде коротких кодов: например ATTN — поправка на ослабление сигнала внутри тела, DECY — поправка на распад радиоактивности."

#: crates/core/src/guide.rs
msgid "The moment to which the scanner corrected the values for the decay of the radioactivity: START means the start of the scan."
msgstr "Момент, к которому аппарат пересчитал значения с поправкой на распад радиоактивности: START означает начало сканирования."

#: crates/core/src/guide.rs
msgid "The amount of radioactivity injected, in megabecquerel (MBq, millions of decays per second), as entered by staff."
msgstr "Количество введённой радиоактивности, в мегабеккерелях (MBq, миллионах распадов в секунду), как его ввёл персонал."

#: crates/core/src/guide.rs
msgid "The time in which the radioactivity of the tracer falls to half, in seconds (s): about 110 minutes for fluorine-18."
msgstr "Время, за которое радиоактивность препарата снижается вдвое, в секундах (s): около 110 минут для фтора-18."

#: crates/core/src/guide.rs
msgid "The time the tracer was injected, as entered by staff. The radioactivity decays between this time and the scan, which the uptake value takes into account."
msgstr "Время введения радиофармпрепарата, как его ввёл персонал. Между этим временем и исследованием радиоактивность распадается, и уровень накопления это учитывает."

#: crates/core/src/guide.rs
msgid "The time the scanner recorded for this series; for a PET series, the moment its values refer to."
msgstr "Время, которое аппарат записал для этой серии; для серии ПЭТ — момент, к которому относятся её значения."

#: crates/core/src/guide.rs
msgid "The tracer that was injected, as entered at the scanner, for example fluorodeoxyglucose (FDG), a form of sugar."
msgstr "Введённый радиофармпрепарат, как его указали на аппарате, например фтордезоксиглюкоза (ФДГ) — разновидность сахара."

#: crates/core/src/guide.rs
msgid "A window stored with the images by the scanner or its operator, usually the one intended for this series."
msgstr "Окно, сохранённое вместе с изображениями аппаратом или оператором; обычно оно предназначено для этой серии."

#: crates/core/src/guide.rs
msgid "A window computed from the brightness values of the images loaded so far: it shows almost all of them and ignores the extremes."
msgstr "Окно, вычисленное по значениям яркости уже загруженных изображений: оно показывает почти все значения и не учитывает крайние."

#: crates/core/src/guide.rs
msgid "A window from the smallest to the largest value in the series: nothing is clipped, but contrast is low."
msgstr "Окно от наименьшего до наибольшего значения в серии: ничего не обрезается, но контраст низкий."

#: crates/core/src/guide.rs
msgid "A built-in window for uptake values (SUV) from SUV 0 to its upper limit: a higher limit keeps differences between high values visible, a lower one shows low values more clearly."
msgstr "Встроенное окно для уровней накопления (SUV) от SUV 0 до верхней границы: при более высокой границе остаются видны различия между высокими значениями, при более низкой лучше видны низкие значения."

#: crates/core/src/guide.rs
msgid "It spreads the grey scale over densities from {low} to {high} HU (Hounsfield units: air is -1000, water 0); everything outside that range is shown as black or white."
msgstr "Оно распределяет шкалу серого по плотностям от {low} до {high} HU (единицы Хаунсфилда: воздух -1000, вода 0); всё, что вне этого диапазона, показано чёрным или белым."

#: crates/core/src/guide.rs
msgid "It spreads the grey scale over values from {low} to {high} {unit}; everything outside that range is shown as black or white."
msgstr "Оно распределяет шкалу серого по значениям от {low} до {high} {unit}; всё, что вне этого диапазона, показано чёрным или белым."

#: crates/core/src/guide.rs
msgid "It spreads the grey scale over values from {low} to {high}; everything outside that range is shown as black or white."
msgstr "Оно распределяет шкалу серого по значениям от {low} до {high}; всё, что вне этого диапазона, показано чёрным или белым."

#: crates/core/src/guide.rs
msgid "A contrast table stored with the images by the equipment: it turns values into grey levels along a curve chosen for these images instead of a straight line. Adjusting the contrast by hand switches to an ordinary window."
msgstr "Таблица контраста, сохранённая оборудованием вместе с изображениями: она переводит значения в уровни серого по кривой, подобранной для этих изображений, а не по прямой. Ручная настройка контраста переключает на обычное окно."

#: crates/core/src/guide.rs
msgid "A narrow window around the density of brain tissue, so that small density differences inside the brain become visible."
msgstr "Узкое окно вокруг плотности ткани мозга, чтобы стали видны небольшие различия плотности внутри мозга."

#: crates/core/src/guide.rs
msgid "A wider window for the head, in which the thin layer between the brain and the skull stays distinguishable from the bone."
msgstr "Более широкое окно для головы, в котором тонкая прослойка между мозгом и черепом остаётся отличимой от кости."

#: crates/core/src/guide.rs
msgid "A very narrow window that exaggerates small density differences in brain tissue; the image looks grainy with it."
msgstr "Очень узкое окно, которое усиливает небольшие различия плотности в ткани мозга; изображение с ним выглядит зернистым."

#: crates/core/src/guide.rs
msgid "A window for the soft tissues of the head and neck, such as muscles and glands."
msgstr "Окно для мягких тканей головы и шеи, например мышц и желёз."

#: crates/core/src/guide.rs
msgid "A very wide window centred on bone, so that fine bone structures, such as those of the ear, stay distinguishable."
msgstr "Очень широкое окно с центром на кости, чтобы тонкие костные структуры, например структуры уха, оставались различимыми."

#: crates/core/src/guide.rs
msgid "A wide window centred on low densities, so that the air-filled lungs with their vessels and airways become visible."
msgstr "Широкое окно с центром на низких плотностях, чтобы стали видны заполненные воздухом лёгкие с их сосудами и дыхательными путями."

#: crates/core/src/guide.rs
msgid "A window for the soft tissues in the middle of the chest, such as the heart and the large vessels; the lungs look black with it."
msgstr "Окно для мягких тканей в середине грудной клетки, например сердца и крупных сосудов; лёгкие с ним выглядят чёрными."

#: crates/core/src/guide.rs
msgid "A window for the soft tissues of the abdomen, such as the liver, the kidneys and the bowel."
msgstr "Окно для мягких тканей живота, например печени, почек и кишечника."

#: crates/core/src/guide.rs
msgid "A narrow window around the density of the liver, so that small density differences inside it become visible."
msgstr "Узкое окно вокруг плотности печени, чтобы стали видны небольшие различия плотности внутри неё."

#: crates/core/src/guide.rs
msgid "A wide window centred on high densities, so that the outer shell and the inner structure of bones become visible."
msgstr "Широкое окно с центром на высоких плотностях, чтобы стали видны наружная оболочка и внутреннее строение костей."

#: crates/core/src/guide.rs
msgid "A window centred above soft tissue, so that vessels filled with contrast agent stand out and stay distinguishable from bone."
msgstr "Окно с центром выше плотности мягких тканей, чтобы сосуды, заполненные контрастным веществом, выделялись и оставались отличимыми от кости."

#: crates/core/src/guide.rs
msgid "A standard CT window."
msgstr "Стандартное окно КТ."

#: crates/core/src/guide.rs
msgid "You are looking from the feet towards the head."
msgstr "Вы смотрите со стороны ног к голове."

#: crates/core/src/guide.rs
msgid "You are looking from the head towards the feet."
msgstr "Вы смотрите со стороны головы к ногам."

#: crates/core/src/guide.rs
msgid "You are looking from the front of the body towards the back."
msgstr "Вы смотрите от передней стороны тела к задней."

#: crates/core/src/guide.rs
msgid "You are looking from the back of the body towards the front."
msgstr "Вы смотрите от задней стороны тела к передней."

#: crates/core/src/guide.rs
msgid "You are looking from the patient's right side towards the left."
msgstr "Вы смотрите от правого бока пациента к левому."

#: crates/core/src/guide.rs
msgid "You are looking from the patient's left side towards the right."
msgstr "Вы смотрите от левого бока пациента к правому."

#: crates/core/src/guide.rs
msgid "The image is tilted: you are looking roughly from the feet towards the head."
msgstr "Изображение наклонено: вы смотрите примерно со стороны ног к голове."

#: crates/core/src/guide.rs
msgid "The image is tilted: you are looking roughly from the head towards the feet."
msgstr "Изображение наклонено: вы смотрите примерно со стороны головы к ногам."

#: crates/core/src/guide.rs
msgid "The image is tilted: you are looking roughly from the front of the body towards the back."
msgstr "Изображение наклонено: вы смотрите примерно от передней стороны тела к задней."

#: crates/core/src/guide.rs
msgid "The image is tilted: you are looking roughly from the back of the body towards the front."
msgstr "Изображение наклонено: вы смотрите примерно от задней стороны тела к передней."

#: crates/core/src/guide.rs
msgid "The image is tilted: you are looking roughly from the patient's right side towards the left."
msgstr "Изображение наклонено: вы смотрите примерно от правого бока пациента к левому."

#: crates/core/src/guide.rs
msgid "The image is tilted: you are looking roughly from the patient's left side towards the right."
msgstr "Изображение наклонено: вы смотрите примерно от левого бока пациента к правому."

#: crates/core/src/guide.rs
msgid "The patient's right side is on the left of the screen."
msgstr "Правая сторона пациента — слева на экране."

#: crates/core/src/guide.rs
msgid "The patient's left side is on the left of the screen."
msgstr "Левая сторона пациента — слева на экране."

#: crates/core/src/guide.rs
msgid "The front of the body is on the left of the screen."
msgstr "Передняя сторона тела — слева на экране."

#: crates/core/src/guide.rs
msgid "The back of the body is on the left of the screen."
msgstr "Задняя сторона тела — слева на экране."

#: crates/core/src/guide.rs
msgid "The head end is on the left of the screen."
msgstr "Сторона головы — слева на экране."

#: crates/core/src/guide.rs
msgid "The feet end is on the left of the screen."
msgstr "Сторона ног — слева на экране."

#: crates/core/src/guide.rs
msgid "Roughly, the patient's right side is on the left of the screen."
msgstr "Примерно: правая сторона пациента — слева на экране."

#: crates/core/src/guide.rs
msgid "Roughly, the patient's left side is on the left of the screen."
msgstr "Примерно: левая сторона пациента — слева на экране."

#: crates/core/src/guide.rs
msgid "Roughly, the front of the body is on the left of the screen."
msgstr "Примерно: передняя сторона тела — слева на экране."

#: crates/core/src/guide.rs
msgid "Roughly, the back of the body is on the left of the screen."
msgstr "Примерно: задняя сторона тела — слева на экране."

#: crates/core/src/guide.rs
msgid "Roughly, the head end is on the left of the screen."
msgstr "Примерно: сторона головы — слева на экране."

#: crates/core/src/guide.rs
msgid "Roughly, the feet end is on the left of the screen."
msgstr "Примерно: сторона ног — слева на экране."

#: crates/core/src/guide.rs
msgid "Axial image"
msgstr "Аксиальное изображение"

#: crates/core/src/guide.rs
msgid "Coronal image"
msgstr "Корональное изображение"

#: crates/core/src/guide.rs
msgid "Sagittal image"
msgstr "Сагиттальное изображение"

#: crates/core/src/guide.rs
msgid "Tilted (oblique) image"
msgstr "Наклонное (косое) изображение"

#: crates/core/src/jobs.rs
msgid "the loader could not be started"
msgstr "не удалось запустить загрузку"

#: crates/core/src/jobs.rs
msgid "the image source panicked"
msgstr "источник изображений аварийно завершил работу"

#: crates/core/src/jobs.rs
msgid "the image is missing from the index"
msgstr "изображения нет в индексе"

#. the measuring tools: a distance, an angle and two shapes of a region.
#: crates/core/src/measure.rs
msgctxt "measuring tool"
msgid "Length"
msgstr "Длина"

#: crates/core/src/measure.rs
msgctxt "measuring tool"
msgid "Angle"
msgstr "Угол"

#: crates/core/src/measure.rs
msgctxt "measuring tool"
msgid "Ellipse"
msgstr "Эллипс"

#: crates/core/src/measure.rs
msgctxt "measuring tool"
msgid "Rectangle"
msgstr "Прямоугольник"

#. keep this statement unambiguous and at least as strong as the English.
#: crates/core/src/measure.rs
msgid "Approximate — not for diagnosis"
msgstr "Приблизительно — не использовать для диагностики"

#. a result in pixels of an image without a scale, such as "123 px (uncalibrated)".
#: crates/core/src/measure.rs
msgid "{value} (uncalibrated)"
msgstr "{value} (без калибровки)"

#. a size on an X-ray image is the size at the detector; the body part itself may be smaller.
#: crates/core/src/measure.rs
msgid "at detector — true size may be smaller"
msgstr "на детекторе — истинный размер может быть меньше"

#. the area of a region, with its unit, such as "Area 2.0 cm²".
#: crates/core/src/measure.rs
msgid "Area {value}"
msgstr "Площадь {value}"

#: crates/core/src/measure.rs
msgid "Computed on a reformat, so approximate: the slices of this series are {spacing} mm apart, and detail across them is coarser than within them."
msgstr "Вычислено по реконструкции, поэтому приблизительно: срезы этой серии расположены через {spacing} mm, и поперёк срезов детализация грубее, чем в их плоскости."

#: crates/core/src/measure.rs
msgid "Scale from the Pixel Spacing recorded in the image."
msgstr "Масштаб по шагу пикселей (Pixel Spacing), указанному в изображении."

#: crates/core/src/measure.rs
msgid "Scale from the Imager Pixel Spacing recorded in the image: sizes at the detector. What lies in front of the detector appears larger on the image, so its true size may be smaller."
msgstr "Масштаб по шагу пикселей на детекторе (Imager Pixel Spacing), указанному в изображении: размеры на детекторе. То, что находится перед детектором, на изображении выглядит крупнее, поэтому истинный размер может быть меньше."

#: crates/core/src/measure.rs
msgid "This image records no pixel spacing: the result is in pixels, assumes square pixels and says nothing about true size."
msgstr "В этом изображении не указан шаг пикселей: результат дан в пикселях, предполагает квадратные пиксели и ничего не говорит об истинном размере."

#: crates/core/src/measure.rs
msgid "Statistics not available for colour images"
msgstr "Статистика недоступна для цветных изображений"

#: crates/core/src/measure.rs
msgid "Values not loaded yet"
msgstr "Значения ещё не загружены"

#: crates/core/src/measure.rs
msgid "No values: the image could not be decoded"
msgstr "Нет значений: изображение не удалось декодировать"

#. statistics of a thick slab: {mode} is MIP, MinIP or Average.
#: crates/core/src/measure.rs
msgid "{mode} values"
msgstr "Значения проекции {mode}"

#. statistics of a region: the mean and the standard deviation (SD) of its values.
#: crates/core/src/measure.rs
msgid "Mean {mean} · SD {sd}"
msgstr "Среднее {mean} · СО {sd}"

#. statistics of a region: the smallest and the largest of its values.
#: crates/core/src/measure.rs
msgid "Min {min} · Max {max}"
msgstr "Мин {min} · Макс {max}"

#: crates/core/src/measure.rs
msgid "No values: outside the scanned area"
msgstr "Нет значений: вне области сканирования"

#: crates/core/src/measure.rs
msgid "Too small: no pixel centre lies inside"
msgstr "Слишком мало: внутри нет ни одного центра пикселя"

#: crates/core/src/measure.rs
msgid "Values of {n} pixel."
msgid_plural "Values of {n} pixels."
msgstr[0] "Значения {n} пикселя."
msgstr[1] "Значения {n} пикселей."
msgstr[2] "Значения {n} пикселей."

#: crates/core/src/measure.rs
msgid "{n} pixel outside the scanned area is left out."
msgid_plural "{n} pixels outside the scanned area are left out."
msgstr[0] "{n} пиксель вне области сканирования не учитывается."
msgstr[1] "{n} пикселя вне области сканирования не учитываются."
msgstr[2] "{n} пикселей вне области сканирования не учитываются."

#: crates/core/src/pet.rs
msgid "SUV {value}"
msgstr "SUV {value}"

#: crates/core/src/pet.rs
msgid "SUV 0–{limit}"
msgstr "SUV 0–{limit}"

#: crates/core/src/pet.rs
msgid "Not recorded"
msgstr "Не указано"

#: crates/core/src/pet.rs
msgid "SUV (standardised uptake value by body weight), computed by SumMRIse; approximate"
msgstr "SUV (стандартизированный уровень накопления по массе тела), вычислен программой SumMRIse; значение приблизительное"

#: crates/core/src/pet.rs
msgid "SUV, as stored in the images by the scanner or a workstation (g/ml)"
msgstr "SUV в том виде, как его записали в изображения аппарат или рабочая станция (g/ml)"

#: crates/core/src/pet.rs
msgid "{unit} as stored; SUV not computed"
msgstr "{unit} в исходном виде; SUV не вычислен"

#: crates/core/src/pet.rs
msgid "Values shown"
msgstr "Показаны значения"

#: crates/core/src/pet.rs
msgid "Not computed because"
msgstr "Почему не вычислен"

#: crates/core/src/pet.rs
msgid "Hidden (privacy mode)"
msgstr "Скрыто (режим конфиденциальности)"

#: crates/core/src/pet.rs
msgid "{weight} kg"
msgstr "{weight} kg"

#: crates/core/src/pet.rs
msgid "Patient weight"
msgstr "Вес пациента"

#: crates/core/src/pet.rs
msgid "{dose} MBq"
msgstr "{dose} MBq"

#: crates/core/src/pet.rs
msgid "Injected dose"
msgstr "Введённая доза"

#: crates/core/src/pet.rs
msgid "Injection time"
msgstr "Время введения"

#: crates/core/src/pet.rs
msgid "Reference time"
msgstr "Опорное время"

#: crates/core/src/pet.rs
msgid "{seconds} s ({minutes} min)"
msgstr "{seconds} s ({minutes} min)"

#: crates/core/src/pet.rs
msgid "Half-life"
msgstr "Период полураспада"

#: crates/core/src/pet.rs
msgid "Decay correction"
msgstr "Поправка на распад"

#: crates/core/src/pet.rs
msgid "Corrections"
msgstr "Поправки"

#: crates/core/src/pet.rs
msgid "Stored unit"
msgstr "Единица в изображениях"

#: crates/core/src/pet.rs
msgid "{tracer} ({nuclide})"
msgstr "{tracer} ({nuclide})"

#: crates/core/src/pet.rs
msgid "Tracer"
msgstr "Радиофармпрепарат"

#: crates/core/src/pet.rs
msgid "{dose} MBq, {after} after the injection"
msgstr "{dose} MBq через {after} после введения"

#: crates/core/src/pet.rs
msgid "Dose at the reference time"
msgstr "Доза на опорное время"

#: crates/core/src/pet.rs
msgid "Uptake values"
msgstr "Уровни накопления"

#: crates/core/src/pet.rs
msgid "{date} {time}"
msgstr "{date} {time}"

