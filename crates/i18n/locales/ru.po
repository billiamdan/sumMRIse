#: crates/ui/src/measure.rs
msgid "Measure"
msgstr "Измерить"

#: crates/ui/src/measure.rs
msgid "Measure: {tool}"
msgstr "Измерить: {tool}"

#: crates/ui/src/measure.rs
msgid "Measure lengths, angles and regions (D, Y, E, Q). Approximate — not for diagnosis."
msgstr "Измерить длины, углы и области (D, Y, E, Q). Приблизительно — не использовать для диагностики."

