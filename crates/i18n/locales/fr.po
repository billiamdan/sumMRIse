msgid_plural "{n} files with the same names already exist in this folder."
msgstr[0] "{n} fichier du même nom existe déjà dans ce dossier."
msgstr[1] "{n} fichiers de mêmes noms existent déjà dans ce dossier."

#: crates/ui/src/export.rs
msgid "Replace"
msgstr "Remplacer"

#. the file format of a saved image.
#: crates/ui/src/export.rs
msgid "Format"
msgstr "Format"

#: crates/ui/src/export.rs
msgid "Include patient details"
msgstr "Inclure les informations sur le patient"

#: crates/ui/src/export.rs
msgid "Adds the patient's name, ID and birth date, for this time only"
msgstr "Ajoute le nom, l'ID et la date de naissance du patient, pour cette fois seulement"

#: crates/ui/src/export.rs
msgid "Privacy mode is on: patient details stay hidden"
msgstr "Le mode confidentialité est activé : les informations sur le patient restent masquées"

#: crates/ui/src/export.rs
msgid "An image-only file has no text"
msgstr "Un fichier avec l'image seule ne contient pas de texte"

#: crates/ui/src/export.rs
msgid "The picture itself may show personal details"
msgstr "L'image elle-même peut montrer des données personnelles"

#: crates/ui/src/export.rs
msgid "Names or other personal details can be part of this picture, as in a scanned page or an ultrasound image. SumMRIse cannot remove them."
msgstr "Des noms ou d'autres données personnelles peuvent faire partie de cette image, comme dans une page numérisée ou une image d'échographie. SumMRIse ne peut pas les supprimer."

#: crates/ui/src/export.rs
