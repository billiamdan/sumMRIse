msgstr "L'appareil n'a enregistré aucun total."

#: crates/ui/src/documents.rs
msgid "All values in this report"
msgstr "Toutes les valeurs de ce rapport"

#: crates/ui/src/documents.rs
msgid "Only the first {count} of {total} pages can be shown."
msgstr "Seules les {count} premières pages sur {total} peuvent être affichées."

#: crates/ui/src/documents.rs
msgid "Part of this page could not be drawn, such as a font or a picture. Something may be missing."
msgstr "Une partie de cette page, comme une police ou une image, n'a pas pu être affichée. Il peut manquer quelque chose."

#: crates/ui/src/documents.rs
msgid "Page {number}"
msgstr "Page {number}"

#: crates/ui/src/documents.rs
msgid "Previous page"
msgstr "Page précédente"

#: crates/ui/src/documents.rs
msgid "Previous page (Page Up)"
msgstr "Page précédente (Page préc.)"

#: crates/ui/src/documents.rs
msgid "Page {number} of {count}"
msgstr "Page {number} sur {count}"

#: crates/ui/src/documents.rs
msgid "Next page"
msgstr "Page suivante"

#: crates/ui/src/documents.rs
msgid "Next page (Page Down)"
msgstr "Page suivante (Page suiv.)"

#: crates/ui/src/documents.rs
msgid "Zoom out"
msgstr "Réduire"

#: crates/ui/src/documents.rs
msgid "Zoom in"
msgstr "Agrandir"

#: crates/ui/src/documents.rs
msgid "Fit to width"
msgstr "Ajuster à la largeur"

#: crates/ui/src/documents.rs
msgid "This file does not say which character set it uses. It is shown as {encoding}, so some letters may be wrong."
msgstr "Ce fichier n'indique pas son jeu de caractères. Il est affiché en {encoding}, certaines lettres peuvent donc être erronées."

#: crates/ui/src/documents.rs
msgid "This document holds no text."
msgstr "Ce document ne contient pas de texte."

#: crates/ui/src/documents.rs
msgid "This document is longer than can be shown; the rest is cut off."
msgstr "Ce document est trop long pour être affiché ; la suite est coupée."

#: crates/ui/src/documents.rs
msgid "This document could not be displayed."
msgstr "Impossible d'afficher ce document."

#: crates/ui/src/documents.rs
msgid "Esc: back to the images · Page Up/Down: move through the document"
msgstr "Échap : retour aux images · Page préc./suiv. : parcourir le document"

#: crates/ui/src/documents.rs
msgid "Documents"
msgstr "Documents"

#: crates/ui/src/documents.rs
