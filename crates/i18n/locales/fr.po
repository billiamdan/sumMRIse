msgstr "Impossible d'enregistrer l'image : elle n'est pas disponible."

#: crates/ui/src/export.rs
#: crates/ui/src/print.rs
msgid "Saved {name}"
msgstr "{name} enregistré"

#: crates/ui/src/export.rs
msgid "Could not save the image: {reason}"
msgstr "Impossible d'enregistrer l'image : {reason}"

#: crates/ui/src/export.rs
