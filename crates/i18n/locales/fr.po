msgstr "Enregistrer la vue en fichier PNG ou JPEG ({shortcut})"

#: crates/ui/src/export.rs
msgid "Copy image"
msgstr "Copier l'image"

#: crates/ui/src/export.rs
msgid "Copy the picture, without patient details, to the clipboard ({shortcut})"
msgstr "Copier l'image, sans informations sur le patient, dans le presse-papiers ({shortcut})"

#: crates/ui/src/export.rs
msgid "Export series…"
msgstr "Exporter la série…"

#: crates/ui/src/export.rs
msgid "Save all images of the series as numbered files ({shortcut})"
msgstr "Enregistrer toutes les images de la série en fichiers numérotés ({shortcut})"

#: crates/ui/src/export.rs
msgid "Print…"
msgstr "Imprimer…"

#: crates/ui/src/export.rs
msgid "Print the image or the series, or save them as a PDF ({shortcut})"
msgstr "Imprimer l'image ou la série, ou les enregistrer en PDF ({shortcut})"

#: crates/ui/src/export.rs
msgid "Save, copy or print"
msgstr "Enregistrer, copier ou imprimer"

#: crates/ui/src/export.rs
msgid "Save or copy the image, export the series, or print"
msgstr "Enregistrer ou copier l'image, exporter la série ou imprimer"

#: crates/ui/src/export.rs
msgid "Save image"
msgstr "Enregistrer l'image"

#: crates/ui/src/export.rs
msgid "Image only"
msgstr "Image seule"

#: crates/ui/src/export.rs
msgid "The 3D picture as computed for the screen, with its caption that it is an illustration."
msgstr "L'image 3D telle qu'elle est calculée pour l'écran, avec la mention qu'il s'agit d'une illustration."

#: crates/ui/src/export.rs
msgid "The picture itself at its own resolution, in the current contrast, without any text. Zoom and pan are left out; it is turned and flipped like the view."
msgstr "L'image elle-même à sa propre résolution, avec le contraste actuel, sans aucun texte. Le zoom et le déplacement sont ignorés ; elle est pivotée et retournée comme la vue."

#: crates/ui/src/export.rs
msgid "With annotations"
msgstr "Avec annotations"

#: crates/ui/src/export.rs
msgid "The view as on screen, with orientation letters, scale bar and contrast values, marked as not for diagnostic use."
msgstr "La vue telle qu'à l'écran, avec lettres d'orientation, barre d'échelle et valeurs de contraste, marquée comme ne devant pas servir au diagnostic."

#: crates/ui/src/export.rs
msgid "This view is mirrored, and the file will be too. An image-only file has no letters to show the true directions."
msgstr "Cette vue est en miroir, le fichier le sera aussi. Un fichier avec l'image seule n'a pas de lettres pour indiquer les vraies directions."

#: crates/ui/src/export.rs
msgid "Save…"
msgstr "Enregistrer…"

#: crates/ui/src/export.rs
msgid "Export series"
msgstr "Exporter la série"

#: crates/ui/src/export.rs
msgid "Saves {n} image as a numbered file, in the current contrast, without any text."
msgid_plural "Saves all {n} images as numbered files, in the current contrast, without any text."
msgstr[0] "Enregistre {n} image en fichier numéroté, avec le contraste actuel, sans aucun texte."
msgstr[1] "Enregistre les {n} images en fichiers numérotés, avec le contraste actuel, sans aucun texte."

#: crates/ui/src/export.rs
msgid "These images are shown mirrored, and the files will be too. They have no letters to show the true directions."
msgstr "Ces images sont affichées en miroir, les fichiers le seront aussi. Ils n'ont pas de lettres pour indiquer les vraies directions."

#: crates/ui/src/export.rs
msgid "Choose folder…"
msgstr "Choisir un dossier…"

#: crates/ui/src/export.rs
msgid "Choose a folder for the images"
msgstr "Choisissez un dossier pour les images"

#: crates/ui/src/export.rs
msgid "Export anyway"
msgstr "Exporter quand même"

#: crates/ui/src/export.rs
msgid "Copy anyway"
msgstr "Copier quand même"

#: crates/ui/src/export.rs
msgid "Replace existing files?"
msgstr "Remplacer les fichiers existants ?"

#: crates/ui/src/export.rs
