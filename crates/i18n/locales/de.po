msgstr "Der Scanner hat keine Gesamtsumme angegeben."

#: crates/ui/src/documents.rs
msgid "All values in this report"
msgstr "Alle Werte dieses Berichts"

#: crates/ui/src/documents.rs
msgid "Only the first {count} of {total} pages can be shown."
msgstr "Nur die ersten {count} von {total} Seiten können angezeigt werden."

#: crates/ui/src/documents.rs
msgid "Part of this page could not be drawn, such as a font or a picture. Something may be missing."
msgstr "Ein Teil dieser Seite, etwa eine Schrift oder ein Bild, konnte nicht dargestellt werden. Es kann etwas fehlen."

#: crates/ui/src/documents.rs
msgid "Page {number}"
msgstr "Seite {number}"

#: crates/ui/src/documents.rs
msgid "Previous page"
msgstr "Vorherige Seite"

#: crates/ui/src/documents.rs
msgid "Previous page (Page Up)"
msgstr "Vorherige Seite (Bild auf)"

#: crates/ui/src/documents.rs
msgid "Page {number} of {count}"
msgstr "Seite {number} von {count}"

#: crates/ui/src/documents.rs
msgid "Next page"
msgstr "Nächste Seite"

#: crates/ui/src/documents.rs
msgid "Next page (Page Down)"
msgstr "Nächste Seite (Bild ab)"

#: crates/ui/src/documents.rs
msgid "Zoom out"
msgstr "Verkleinern"

#: crates/ui/src/documents.rs
msgid "Zoom in"
msgstr "Vergrößern"

#: crates/ui/src/documents.rs
msgid "Fit to width"
msgstr "An Breite anpassen"

#: crates/ui/src/documents.rs
msgid "This file does not say which character set it uses. It is shown as {encoding}, so some letters may be wrong."
msgstr "Diese Datei gibt ihren Zeichensatz nicht an. Sie wird als {encoding} angezeigt, daher können einzelne Buchstaben falsch sein."

#: crates/ui/src/documents.rs
msgid "This document holds no text."
msgstr "Dieses Dokument enthält keinen Text."

#: crates/ui/src/documents.rs
msgid "This document is longer than can be shown; the rest is cut off."
msgstr "Dieses Dokument ist zu lang für die Anzeige; der Rest ist abgeschnitten."

#: crates/ui/src/documents.rs
msgid "This document could not be displayed."
msgstr "Dieses Dokument konnte nicht angezeigt werden."

#: crates/ui/src/documents.rs
msgid "Esc: back to the images · Page Up/Down: move through the document"
msgstr "Esc: zurück zu den Bildern · Bild auf/ab: im Dokument blättern"

#: crates/ui/src/documents.rs
msgid "Documents"
msgstr "Dokumente"

#: crates/ui/src/documents.rs
msgid "Other files on the disc"
msgstr "Weitere Dateien auf dem Datenträger"

#: crates/ui/src/documents.rs
msgid "too large to display"
msgstr "zu groß für die Anzeige"

#. S is short for series, followed by the series number; {title} is the series' name.
#: crates/ui/src/export/picture.rs
#: crates/ui/src/tiles.rs
#: crates/ui/src/viewport.rs
msgid "S{number}: {title}"
msgstr "S{number}: {title}"

#. the patient ID on the image.
#: crates/ui/src/export/picture.rs
#: crates/ui/src/viewport.rs
msgid "ID {id}"
msgstr "ID {id}"

#: crates/ui/src/export/picture.rs
#: crates/ui/src/viewport.rs
msgid "Born {date}"
msgstr "Geb. {date}"

#: crates/ui/src/export/picture.rs
#: crates/ui/src/viewport.rs
msgid "Image {number} / {count}"
msgstr "Bild {number} / {count}"

#: crates/ui/src/export/picture.rs
#: crates/ui/src/viewport.rs
msgid "Image {number} could not be decoded"
msgstr "Bild {number} konnte nicht dekodiert werden"

#. {view} is the name of a view, such as Axial or Coronal.
#: crates/ui/src/export/picture.rs
#: crates/ui/src/viewport.rs
msgid "{view} {number} / {count}"
msgstr "{view} {number} / {count}"

#. a reformat is an image computed through the volume in another plane; {view} names it.
#: crates/ui/src/export/picture.rs
msgid "Reformat: {view}"
msgstr "Rekonstruktion: {view}"

#. {mode} is MIP, MinIP or Average; the slab's thickness follows in millimetres.
#: crates/ui/src/export/picture.rs
#: crates/ui/src/viewport.rs
