msgstr "Kontrasttabelle: {name}"

#: crates/ui/src/export.rs
msgid "Available when the image on screen has loaded"
msgstr "Verfügbar, sobald das angezeigte Bild geladen ist"

#: crates/ui/src/export.rs
msgid "Available when all images of the series have loaded"
msgstr "Verfügbar, sobald alle Bilder der Serie geladen sind"

#: crates/ui/src/export.rs
#: crates/ui/src/volume_view.rs
#: crates/ui/src/welcome.rs
msgid "Shift+{key}"
msgstr "Umschalt+{key}"

#: crates/ui/src/export.rs
msgid "Save image…"
msgstr "Bild speichern…"

#: crates/ui/src/export.rs
msgid "Save the view as a PNG or JPEG file ({shortcut})"
msgstr "Die Ansicht als PNG- oder JPEG-Datei speichern ({shortcut})"

#: crates/ui/src/export.rs
msgid "Copy image"
msgstr "Bild kopieren"

#: crates/ui/src/export.rs
