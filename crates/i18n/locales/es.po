# Spanish translations of SumMRIse.
# Brought up to date with the source code by `cargo xtask i18n`; translators fill in the msgstr lines.
# Rules for translators: design.md of the OpenSpec change `translations`.
# Plural forms: msgstr[0] for 1; msgstr[1] for 0, 2, 3, 4, 5, 6, ….
msgid ""
msgstr ""
"Project-Id-Version: SumMRIse\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: crates/core/src/guide.rs
msgid "General information about how these images were made, not an interpretation of the images."
msgstr "Información general sobre cómo se obtuvieron estas imágenes, no una interpretación de las imágenes."

#: crates/core/src/guide.rs
msgid "The settings are read from one image of the series; other images of the series may differ."
msgstr "Los parámetros se leen de una imagen de la serie; otras imágenes de la serie pueden ser distintas."

#: crates/core/src/guide.rs
msgid "Named by the scanner operator: the series description reads “{name}”."
msgstr "Nombre dado por el operador del escáner: la descripción de la serie dice “{name}”."

#: crates/core/src/guide.rs
msgid "Named by the scanner operator: the protocol name reads “{name}”."
msgstr "Nombre dado por el operador del escáner: el nombre del protocolo dice “{name}”."

#: crates/core/src/guide.rs
msgid "Recorded in the images: image type LOCALIZER."
msgstr "Registrado en las imágenes: tipo de imagen LOCALIZER."

#: crates/core/src/guide.rs
msgid "For this kind of sequence the recorded timing does not settle the weighting."
msgstr "Con este tipo de secuencia, los tiempos registrados no permiten determinar la ponderación."

#: crates/core/src/guide.rs
msgid "No repetition time or echo time is recorded."
msgstr "Las imágenes no registran el tiempo de repetición ni el tiempo de eco."

#: crates/core/src/guide.rs
msgid "The images do not record which type of sequence was used."
msgstr "Las imágenes no registran qué tipo de secuencia se utilizó."

#: crates/core/src/guide.rs
msgid "Inferred from the recorded settings: a gradient-echo sequence with a long echo time ({te} ms) and a small flip angle ({flip} degrees)."
msgstr "Deducido de los parámetros registrados: una secuencia de eco de gradiente con un tiempo de eco largo ({te} ms) y un ángulo de inclinación pequeño ({flip} grados)."

#: crates/core/src/guide.rs
msgid "For this gradient-echo sequence the recorded timing does not settle the weighting."
msgstr "Con esta secuencia de eco de gradiente, los tiempos registrados no permiten determinar la ponderación."

#: crates/core/src/guide.rs
msgid "An inversion pulse is recorded, but not its timing."
msgstr "Se registra un pulso de inversión, pero no su tiempo."

#: crates/core/src/guide.rs
msgid "Inferred from the recorded timing: repetition time {tr} ms and a short inversion time ({ti} ms), which suppresses the signal of fat."
msgstr "Deducido de los tiempos registrados: tiempo de repetición de {tr} ms y un tiempo de inversión corto ({ti} ms), que suprime la señal de la grasa."

#: crates/core/src/guide.rs
msgid "Inferred from the recorded timing: long repetition time ({tr} ms), long echo time ({te} ms) and a long inversion time ({ti} ms), which suppresses the signal of fluid."
msgstr "Deducido de los tiempos registrados: tiempo de repetición largo ({tr} ms), tiempo de eco largo ({te} ms) y un tiempo de inversión largo ({ti} ms), que suprime la señal del líquido."

#: crates/core/src/guide.rs
msgid "An inversion time of {ti} ms fits none of the rules this guide uses."
msgstr "Un tiempo de inversión de {ti} ms no encaja en ninguna de las reglas que usa esta guía."

#: crates/core/src/guide.rs
msgid "Inferred from the recorded timing: short repetition time ({tr} ms) and short echo time ({te} ms)."
msgstr "Deducido de los tiempos registrados: tiempo de repetición corto ({tr} ms) y tiempo de eco corto ({te} ms)."

#: crates/core/src/guide.rs
msgid "Inferred from the recorded timing: long repetition time ({tr} ms) and long echo time ({te} ms)."
msgstr "Deducido de los tiempos registrados: tiempo de repetición largo ({tr} ms) y tiempo de eco largo ({te} ms)."

#: crates/core/src/guide.rs
msgid "Inferred from the recorded timing: long repetition time ({tr} ms) and short echo time ({te} ms)."
msgstr "Deducido de los tiempos registrados: tiempo de repetición largo ({tr} ms) y tiempo de eco corto ({te} ms)."

#: crates/core/src/guide.rs
msgid "Repetition time {tr} ms and echo time {te} ms fit none of the rules this guide uses."
msgstr "Un tiempo de repetición de {tr} ms y un tiempo de eco de {te} ms no encajan en ninguna de las reglas que usa esta guía."

#: crates/core/src/guide.rs
msgid "Recorded in the images: image type ADC."
msgstr "Registrado en las imágenes: tipo de imagen ADC."

#: crates/core/src/guide.rs
msgid "Recorded in the images: diffusion b-value {b} s/mm²."
msgstr "Registrado en las imágenes: valor b de difusión {b} s/mm²."

#: crates/core/src/guide.rs
msgid "Recorded in the images: image type DIFFUSION."
msgstr "Registrado en las imágenes: tipo de imagen DIFFUSION."

#: crates/core/src/guide.rs
msgid "MR scan"
msgstr "Resonancia magnética (RM)"

#: crates/core/src/guide.rs
msgid "MR scan, T1-weighted"
msgstr "RM ponderada en T1"

#: crates/core/src/guide.rs
msgid "MR scan, likely T1-weighted"
msgstr "RM, probablemente ponderada en T1"

#: crates/core/src/guide.rs
msgid "MR scan, T2-weighted"
msgstr "RM ponderada en T2"

#: crates/core/src/guide.rs
msgid "MR scan, likely T2-weighted"
msgstr "RM, probablemente ponderada en T2"

#: crates/core/src/guide.rs
msgid "MR scan, proton-density-weighted"
msgstr "RM ponderada en densidad protónica"

#: crates/core/src/guide.rs
msgid "MR scan, likely proton-density-weighted"
msgstr "RM, probablemente ponderada en densidad protónica"

#: crates/core/src/guide.rs
msgid "MR scan, T2*-weighted"
msgstr "RM ponderada en T2*"

#: crates/core/src/guide.rs
msgid "MR scan, likely T2*-weighted"
msgstr "RM, probablemente ponderada en T2*"

#: crates/core/src/guide.rs
msgid "MR scan, T2 FLAIR (fluid suppressed)"
msgstr "RM T2 FLAIR (supresión de líquido)"

#: crates/core/src/guide.rs
msgid "MR scan, likely T2 FLAIR (fluid suppressed)"
msgstr "RM, probablemente T2 FLAIR (supresión de líquido)"

#: crates/core/src/guide.rs
msgid "MR scan, T1 FLAIR (fluid suppressed)"
msgstr "RM T1 FLAIR (supresión de líquido)"

#: crates/core/src/guide.rs
msgid "MR scan, STIR (fat suppressed)"
msgstr "RM STIR (supresión de grasa)"

#: crates/core/src/guide.rs
msgid "MR scan, likely STIR (fat suppressed)"
msgstr "RM, probablemente STIR (supresión de grasa)"

#: crates/core/src/guide.rs
msgid "MR scan, diffusion-weighted"
msgstr "RM ponderada en difusión"

#: crates/core/src/guide.rs
msgid "MR scan, ADC map (calculated)"
msgstr "RM, mapa ADC (calculado)"

#: crates/core/src/guide.rs
msgid "The weighting of these images cannot be told from what is recorded."
msgstr "La ponderación de estas imágenes no se puede determinar a partir de lo registrado."

#: crates/core/src/guide.rs
msgid "T1-weighted: on such images fat tends to appear bright and fluid dark."
msgstr "Ponderada en T1: en estas imágenes la grasa suele verse brillante y el líquido, oscuro."

#: crates/core/src/guide.rs
msgid "Likely T1-weighted: on such images fat tends to appear bright and fluid dark."
msgstr "Probablemente ponderada en T1: en estas imágenes la grasa suele verse brillante y el líquido, oscuro."

#: crates/core/src/guide.rs
msgid "T2-weighted: on such images fluid tends to appear bright."
msgstr "Ponderada en T2: en estas imágenes el líquido suele verse brillante."

#: crates/core/src/guide.rs
msgid "Likely T2-weighted: on such images fluid tends to appear bright."
msgstr "Probablemente ponderada en T2: en estas imágenes el líquido suele verse brillante."

#: crates/core/src/guide.rs
msgid "Proton-density-weighted: on such images brightness mainly follows how much water and fat a tissue contains, so fluid and fat both appear fairly bright."
msgstr "Ponderada en densidad protónica: en estas imágenes el brillo depende sobre todo de cuánta agua y grasa contiene un tejido, por lo que tanto el líquido como la grasa se ven bastante brillantes."

#: crates/core/src/guide.rs
msgid "Likely proton-density-weighted: on such images brightness mainly follows how much water and fat a tissue contains, so fluid and fat both appear fairly bright."
msgstr "Probablemente ponderada en densidad protónica: en estas imágenes el brillo depende sobre todo de cuánta agua y grasa contiene un tejido, por lo que tanto el líquido como la grasa se ven bastante brillantes."

#: crates/core/src/guide.rs
msgid "T2*-weighted: such images are very sensitive to small disturbances of the magnetic field; places where the field is disturbed, for example next to air, tend to appear dark."
msgstr "Ponderada en T2*: estas imágenes son muy sensibles a pequeñas alteraciones del campo magnético; los lugares donde el campo está alterado, por ejemplo junto al aire, suelen verse oscuros."

#: crates/core/src/guide.rs
msgid "Likely T2*-weighted: such images are very sensitive to small disturbances of the magnetic field; places where the field is disturbed, for example next to air, tend to appear dark."
msgstr "Probablemente ponderada en T2*: estas imágenes son muy sensibles a pequeñas alteraciones del campo magnético; los lugares donde el campo está alterado, por ejemplo junto al aire, suelen verse oscuros."

#: crates/core/src/guide.rs
msgid "T2 FLAIR: like a T2-weighted image, but the signal of free fluid is suppressed, so fluid such as that around the brain appears dark."
msgstr "T2 FLAIR: como una imagen ponderada en T2, pero con la señal del líquido libre suprimida, de modo que el líquido, como el que rodea el cerebro, se ve oscuro."

#: crates/core/src/guide.rs
msgid "Likely T2 FLAIR: like a T2-weighted image, but the signal of free fluid is suppressed, so fluid such as that around the brain appears dark."
msgstr "Probablemente T2 FLAIR: como una imagen ponderada en T2, pero con la señal del líquido libre suprimida, de modo que el líquido, como el que rodea el cerebro, se ve oscuro."

#: crates/core/src/guide.rs
msgid "T1 FLAIR: a T1-weighted image made with an extra preparation pulse that suppresses the signal of free fluid, which appears dark."
msgstr "T1 FLAIR: una imagen ponderada en T1 obtenida con un pulso de preparación adicional que suprime la señal del líquido libre, que se ve oscuro."

#: crates/core/src/guide.rs
msgid "STIR: the signal of fat is suppressed and appears dark, while fluid tends to appear bright."
msgstr "STIR: la señal de la grasa se suprime y se ve oscura, mientras que el líquido suele verse brillante."

#: crates/core/src/guide.rs
msgid "Likely STIR: the signal of fat is suppressed and appears dark, while fluid tends to appear bright."
msgstr "Probablemente STIR: la señal de la grasa se suprime y se ve oscura, mientras que el líquido suele verse brillante."

#: crates/core/src/guide.rs
msgid "Diffusion-weighted: such images are sensitive to how freely water molecules move in the tissue; where they move less freely, the image tends to be brighter."
msgstr "Ponderada en difusión: estas imágenes son sensibles a la libertad con que se mueven las moléculas de agua en el tejido; donde se mueven con menos libertad, la imagen suele ser más brillante."

#: crates/core/src/guide.rs
msgid "ADC map: an image calculated from diffusion-weighted images, not measured directly; brighter means that water moves more freely."
msgstr "Mapa ADC: una imagen calculada a partir de imágenes ponderadas en difusión, no medida directamente; más brillante significa que el agua se mueve con más libertad."

#: crates/core/src/guide.rs
msgid "CT scan"
msgstr "Tomografía computarizada (TC)"

#: crates/core/src/guide.rs
msgid "Localizer (planning overview)"
msgstr "Localizador (vista de planificación)"

#: crates/core/src/guide.rs
msgid "Dose report (a stored picture)"
msgstr "Informe de dosis (imagen guardada)"

#: crates/core/src/guide.rs
msgid "Stored picture (secondary capture)"
msgstr "Imagen guardada (captura secundaria)"

#: crates/core/src/guide.rs
msgid "PET scan"
msgstr "Tomografía PET"

#: crates/core/src/guide.rs
msgid "Nuclear medicine image"
msgstr "Imagen de medicina nuclear"

#: crates/core/src/guide.rs
msgid "Ultrasound image"
msgstr "Ecografía (ultrasonido)"

#: crates/core/src/guide.rs
msgid "X-ray image"
msgstr "Radiografía"

#: crates/core/src/guide.rs
msgid "Mammogram (X-ray image)"
msgstr "Mamografía (radiografía)"

#: crates/core/src/guide.rs
msgid "X-ray fluoroscopy or angiography"
msgstr "Fluoroscopia o angiografía (rayos X)"

#: crates/core/src/guide.rs
msgid "Unrecognised kind of images"
msgstr "Tipo de imágenes no reconocido"

#: crates/core/src/guide.rs
msgid "A CT scan (computed tomography) measures with X-rays from many directions and computes cross-sections of the body from them. On the usual display, denser means brighter: bone is bright, air is dark."
msgstr "Una TC (tomografía computarizada) mide con rayos X desde muchas direcciones y, a partir de esas medidas, calcula cortes del cuerpo. En la visualización habitual, lo más denso se ve más claro: el hueso es claro y el aire, oscuro."

#: crates/core/src/guide.rs
msgid "An MR scan (magnetic resonance imaging) is made with a strong magnet and radio waves, without X-rays. Which tissues appear bright depends on the settings of each series."
msgstr "Una RM (resonancia magnética) se obtiene con un imán potente y ondas de radio, sin rayos X. Qué tejidos se ven brillantes depende de los parámetros de cada serie."

#: crates/core/src/guide.rs
msgid "A localizer (also called scout or survey): quick overview images that the operator uses to plan the other series. They are coarse on purpose."
msgstr "Un localizador (también llamado scout o survey): imágenes rápidas de conjunto que el operador usa para planificar las demás series. Son poco detalladas a propósito."

#: crates/core/src/guide.rs
msgid "A picture of the dose report: a table of the radiation dose values that the scanner recorded for this examination. It is a stored picture, not a scan of the body."
msgstr "Una imagen del informe de dosis: una tabla con los valores de dosis de radiación que el escáner registró en esta exploración. Es una imagen guardada, no una imagen del cuerpo."

#: crates/core/src/guide.rs
msgid "A stored picture (secondary capture), such as a screenshot, a computed 3D view or a scanned document. It was produced by a workstation or by the scanner software, not measured directly."
msgstr "Una imagen guardada (captura secundaria), como una captura de pantalla, una vista 3D calculada o un documento escaneado. La generó una estación de trabajo o el software del escáner; no se midió directamente."

#: crates/core/src/guide.rs
msgid "A PET scan (positron emission tomography) shows where a weakly radioactive tracer has collected in the body."
msgstr "Una PET (tomografía por emisión de positrones) muestra dónde se acumula en el cuerpo un trazador débilmente radiactivo."

#: crates/core/src/guide.rs
msgid "A nuclear medicine image shows where a weakly radioactive tracer has collected in the body, recorded by a gamma camera."
msgstr "Una imagen de medicina nuclear, registrada con una gammacámara, muestra dónde se acumula en el cuerpo un trazador débilmente radiactivo."

#: crates/core/src/guide.rs
msgid "An ultrasound image is made with sound waves that the tissues reflect, without X-rays."
msgstr "Una ecografía (ultrasonido) se obtiene con ondas sonoras que los tejidos reflejan, sin rayos X."

#: crates/core/src/guide.rs
msgid "An X-ray image (projection): X-rays pass through the body onto a detector, so structures lying behind each other overlap in one picture."
msgstr "Una radiografía (proyección): los rayos X atraviesan el cuerpo hasta un detector, por lo que las estructuras situadas una detrás de otra se superponen en una misma imagen."

#: crates/core/src/guide.rs
msgid "A mammogram: an X-ray projection image of the breast."
msgstr "Una mamografía: una radiografía de proyección de la mama."

#: crates/core/src/guide.rs
msgid "X-ray fluoroscopy or angiography: X-ray projection images, often recorded as a moving sequence, for example while a contrast agent flows through vessels."
msgstr "Fluoroscopia o angiografía: imágenes de proyección con rayos X, a menudo registradas como una secuencia en movimiento, por ejemplo mientras un medio de contraste fluye por los vasos."

#: crates/core/src/guide.rs
msgid "This guide does not recognise what kind of images these are."
msgstr "Esta guía no reconoce qué tipo de imágenes son."

#: crates/core/src/guide.rs
msgid "The files are stored pictures and the series description reads “{name}”."
msgstr "Los archivos son imágenes guardadas y la descripción de la serie dice “{name}”."

#: crates/core/src/guide.rs
msgid "Recorded in the images: the files are secondary captures."
msgstr "Registrado en las imágenes: los archivos son capturas secundarias."

#: crates/core/src/guide.rs
msgid "Recorded in the images: modality {modality}."
msgstr "Registrado en las imágenes: modalidad {modality}."

#: crates/core/src/guide.rs
msgid "The slices are axial: horizontal cross-sections of the body, like the slices of a loaf of bread."
msgstr "Los cortes son axiales: secciones horizontales del cuerpo, como las rebanadas de un pan."

#: crates/core/src/guide.rs
msgid "The slices are coronal: they divide the body into front and back, like a view from the front."
msgstr "Los cortes son coronales: dividen el cuerpo en una parte delantera y otra trasera, como una vista de frente."

#: crates/core/src/guide.rs
msgid "The slices are sagittal: they divide the body into left and right, like a view from the side."
msgstr "Los cortes son sagitales: dividen el cuerpo en izquierda y derecha, como una vista de lado."

#: crates/core/src/guide.rs
msgid "The slices are tilted (oblique): they lie between the standard directions."
msgstr "Los cortes están inclinados (oblicuos): quedan entre las direcciones estándar."

#: crates/core/src/guide.rs
msgid "The images of this series lie in different directions."
msgstr "Las imágenes de esta serie tienen distintas orientaciones."

#: crates/core/src/guide.rs
msgid "This series holds {n} time point of the same slices."
msgid_plural "This series holds {n} time points of the same slices."
msgstr[0] "Esta serie contiene {n} punto temporal de los mismos cortes."
msgstr[1] "Esta serie contiene {n} puntos temporales de los mismos cortes."

#: crates/core/src/guide.rs
msgid "Recorded in the images: temporal position."
msgstr "Registrado en las imágenes: posición temporal."

#: crates/core/src/guide.rs
msgid "This series holds {n} phase of the heartbeat at the same slices."
msgid_plural "This series holds {n} phases of the heartbeat at the same slices."
msgstr[0] "Esta serie contiene {n} fase del ciclo cardíaco en los mismos cortes."
msgstr[1] "Esta serie contiene {n} fases del ciclo cardíaco en los mismos cortes."

#: crates/core/src/guide.rs
msgid "Recorded in the images: trigger time."
msgstr "Registrado en las imágenes: tiempo de disparo (trigger time)."

#: crates/core/src/guide.rs
msgid "This series holds {n} echo of the same slices: images taken at different echo times."
msgid_plural "This series holds {n} echoes of the same slices: images taken at different echo times."
msgstr[0] "Esta serie contiene {n} eco de los mismos cortes: imágenes tomadas con distintos tiempos de eco."
msgstr[1] "Esta serie contiene {n} ecos de los mismos cortes: imágenes tomadas con distintos tiempos de eco."

#: crates/core/src/guide.rs
msgid "Recorded in the images: echo number and echo time."
msgstr "Registrado en las imágenes: número de eco y tiempo de eco."

#: crates/core/src/guide.rs
msgid "This series holds {n} diffusion weighting (b-value) of the same slices."
msgid_plural "This series holds {n} diffusion weightings (b-values) of the same slices."
msgstr[0] "Esta serie contiene {n} ponderación de difusión (valor b) de los mismos cortes."
msgstr[1] "Esta serie contiene {n} ponderaciones de difusión (valores b) de los mismos cortes."

#: crates/core/src/guide.rs
msgid "Recorded in the images: diffusion b-value."
msgstr "Registrado en las imágenes: valor b de difusión."

#: crates/core/src/guide.rs
msgid "This series holds {n} kind of image of the same slices."
msgid_plural "This series holds {n} kinds of image of the same slices."
msgstr[0] "Esta serie contiene {n} tipo de imagen de los mismos cortes."
msgstr[1] "Esta serie contiene {n} tipos de imagen de los mismos cortes."

#: crates/core/src/guide.rs
msgid "Recorded in the images: image type."
msgstr "Registrado en las imágenes: tipo de imagen."

#: crates/core/src/guide.rs
msgid "This series holds {n} acquisition of the same slices."
msgid_plural "This series holds {n} acquisitions of the same slices."
msgstr[0] "Esta serie contiene {n} adquisición de los mismos cortes."
msgstr[1] "Esta serie contiene {n} adquisiciones de los mismos cortes."

#: crates/core/src/guide.rs
msgid "Recorded in the images: acquisition number."
msgstr "Registrado en las imágenes: número de adquisición."

#: crates/core/src/guide.rs
msgid "This series holds {n} set of the same slices, made with a different sequence."
msgid_plural "This series holds {n} sets of the same slices, made with different sequences."
msgstr[0] "Esta serie contiene {n} grupo de los mismos cortes, obtenido con otra secuencia."
msgstr[1] "Esta serie contiene {n} grupos de los mismos cortes, obtenidos con secuencias distintas."

#: crates/core/src/guide.rs
msgid "Recorded in the images: sequence name."
msgstr "Registrado en las imágenes: nombre de la secuencia."

#: crates/core/src/guide.rs
msgid "This series holds {n} set of images of the same slices."
msgid_plural "This series holds {n} sets of images of the same slices."
msgstr[0] "Esta serie contiene {n} grupo de imágenes de los mismos cortes."
msgstr[1] "Esta serie contiene {n} grupos de imágenes de los mismos cortes."

#: crates/core/src/guide.rs
msgid "The images repeat the same slice positions, and nothing recorded in them tells the sets apart."
msgstr "Las imágenes repiten las mismas posiciones de corte y nada de lo registrado en ellas permite distinguir los grupos."

#: crates/core/src/guide.rs
msgid "The images were measured slice by slice (2D)."
msgstr "Las imágenes se midieron corte a corte (2D)."

#: crates/core/src/guide.rs
msgid "A whole block of the body was measured at once (3D) and then divided into the slices shown."
msgstr "Se midió de una vez todo un volumen del cuerpo (3D), que luego se dividió en los cortes que se muestran."

#: crates/core/src/guide.rs
msgid "Recorded in the images: MR acquisition type."
msgstr "Registrado en las imágenes: tipo de adquisición de RM."

#: crates/core/src/guide.rs
msgid "No contrast agent is recorded for this series, which does not rule one out: not every scanner records it."
msgstr "No hay ningún medio de contraste registrado para esta serie, lo que no descarta que se haya usado: no todos los escáneres lo registran."

#: crates/core/src/guide.rs
msgid "The contrast agent entry of the images reads “{value}”."
msgstr "El campo de medio de contraste de las imágenes dice “{value}”."

#: crates/core/src/guide.rs
msgid "A contrast agent is recorded for this series: {agent}."
msgstr "Hay un medio de contraste registrado para esta serie: {agent}."

#: crates/core/src/guide.rs
msgid "Recorded in the images: contrast agent."
msgstr "Registrado en las imágenes: medio de contraste."

#: crates/core/src/guide.rs
msgid "The contrast agent entry of the images is absent or empty."
msgstr "El campo de medio de contraste de las imágenes falta o está vacío."

#: crates/core/src/guide.rs
msgid "Recorded in the images: image orientation."
msgstr "Registrado en las imágenes: orientación de la imagen."

#: crates/core/src/guide.rs
msgid "Each image shows a slice of the body {thickness} mm thick."
msgstr "Cada imagen muestra un corte del cuerpo de {thickness} mm de grosor."

#: crates/core/src/guide.rs
msgid "Recorded in the images: slice thickness."
msgstr "Registrado en las imágenes: grosor de corte."

#: crates/core/src/guide.rs
msgid "Computed with the reconstruction kernel “{kernel}”, as recorded by the scanner. The kernel sets the balance between sharp detail and low grain."
msgstr "Calculadas con el kernel de reconstrucción “{kernel}”, según lo registró el escáner. El kernel fija el equilibrio entre detalle nítido y poco grano."

#: crates/core/src/guide.rs
msgid "Recorded in the images: convolution kernel."
msgstr "Registrado en las imágenes: kernel de convolución."

#: crates/core/src/guide.rs
msgid "The time between two successive excitations of the same slice, in milliseconds (ms, thousandths of a second). Together with the echo time it largely decides which tissues appear bright."
msgstr "El tiempo entre dos excitaciones sucesivas del mismo corte, en milisegundos (ms, milésimas de segundo). Junto con el tiempo de eco, determina en gran parte qué tejidos se ven brillantes."

#: crates/core/src/guide.rs
msgid "The time between exciting the tissue and measuring its signal, in milliseconds (ms, thousandths of a second). With a long echo time, fluid stands out as bright."
msgstr "El tiempo entre la excitación del tejido y la medición de su señal, en milisegundos (ms, milésimas de segundo). Con un tiempo de eco largo, el líquido destaca como brillante."

#: crates/core/src/guide.rs
msgid "The waiting time after an extra preparation pulse, in milliseconds (ms, thousandths of a second). It is chosen so that the signal of one tissue, such as fat or fluid, is suppressed."
msgstr "El tiempo de espera tras un pulso de preparación adicional, en milisegundos (ms, milésimas de segundo). Se elige para suprimir la señal de un tejido, como la grasa o el líquido."

#: crates/core/src/guide.rs
msgid "How far the radio pulse tips the magnetisation of the tissue, in degrees. It influences brightness and contrast."
msgstr "Cuánto inclina el pulso de radio la magnetización del tejido, en grados. Influye en el brillo y el contraste."

#: crates/core/src/guide.rs
msgid "The number of echoes measured after each excitation. More echoes shorten the scan."
msgstr "El número de ecos medidos tras cada excitación. Más ecos acortan la exploración."

#: crates/core/src/guide.rs
msgid "How many times each measurement was repeated and averaged. More averages give a less grainy image but take longer."
msgstr "Cuántas veces se repitió y promedió cada medición. Más promedios dan una imagen menos granulada, pero tardan más."

#: crates/core/src/guide.rs
msgid "The radio frequency the scanner worked at, in megahertz (MHz, millions of cycles per second). It follows from the strength of the magnet."
msgstr "La radiofrecuencia con la que trabajó el escáner, en megahercios (MHz, millones de ciclos por segundo). Depende de la intensidad del imán."

#: crates/core/src/guide.rs
msgid "The range of signal frequencies that falls into one pixel, in hertz per pixel (Hz/px). It affects image grain and some distortions."
msgstr "El rango de frecuencias de señal que corresponde a un píxel, en hercios por píxel (Hz/px). Influye en el grano de la imagen y en algunas distorsiones."

#: crates/core/src/guide.rs
msgid "The receiver coil, a kind of antenna placed near the body, that picked up the signal, as named by the scanner."
msgstr "La bobina receptora, una especie de antena colocada cerca del cuerpo, que captó la señal, con el nombre que le da el escáner."

#: crates/core/src/guide.rs
msgid "The scanner's internal name of the measuring programme (pulse sequence). The names differ between manufacturers."
msgstr "El nombre interno que da el escáner al programa de medición (secuencia de pulsos). Los nombres varían según el fabricante."

#: crates/core/src/guide.rs
msgid "The basic measuring technique: spin echo, gradient echo, inversion recovery or echo planar. It shapes how tissues differ in brightness."
msgstr "La técnica de medición básica: eco de espín, eco de gradiente, inversión-recuperación o eco planar. Determina cómo se diferencian los tejidos en brillo."

#: crates/core/src/guide.rs
msgid "Options of the measuring technique, recorded by the scanner as short codes, for example SP for spoiled or SK for segmented."
msgstr "Opciones de la técnica de medición, registradas por el escáner como códigos cortos, por ejemplo SP (spoiled) o SK (segmentada)."

#: crates/core/src/guide.rs
msgid "Further options used for the scan, recorded by the scanner as short codes, for example FS for fat suppression."
msgstr "Otras opciones usadas en la exploración, registradas por el escáner como códigos cortos, por ejemplo FS para la supresión de grasa."

#: crates/core/src/guide.rs
msgid "2D means the body was measured slice by slice. 3D means a whole block was measured at once and then divided into slices."
msgstr "2D significa que el cuerpo se midió corte a corte. 3D significa que se midió de una vez todo un volumen y luego se dividió en cortes."

#: crates/core/src/guide.rs
msgid "The strength of the scanner's main magnet, in tesla (T). Most scanners have 1.5 T or 3 T."
msgstr "La intensidad del imán principal del escáner, en teslas (T). La mayoría de los escáneres tienen 1.5 T o 3 T."

#: crates/core/src/guide.rs
msgid "The voltage of the X-ray tube, in kilovolts (kV, thousands of volts). It sets how penetrating the X-rays are."
msgstr "El voltaje del tubo de rayos X, en kilovoltios (kV, miles de voltios). Determina la capacidad de penetración de los rayos X."

#: crates/core/src/guide.rs
msgid "The electric current through the X-ray tube, in milliamperes (mA, thousandths of an ampere). A higher current produces more X-rays: a less grainy image at a higher dose."
msgstr "La corriente eléctrica que pasa por el tubo de rayos X, en miliamperios (mA, milésimas de amperio). Una corriente mayor produce más rayos X: una imagen menos granulada con una dosis mayor."

#: crates/core/src/guide.rs
msgid "Tube current multiplied by exposure time, in milliampere-seconds (mAs). It is a measure of the amount of X-rays used for this image."
msgstr "La corriente del tubo multiplicada por el tiempo de exposición, en miliamperios-segundo (mAs). Es una medida de la cantidad de rayos X usada para esta imagen."

#: crates/core/src/guide.rs
msgid "How long the X-rays were on for this image, in milliseconds (ms, thousandths of a second)."
msgstr "Cuánto tiempo estuvieron activos los rayos X para esta imagen, en milisegundos (ms, milésimas de segundo)."

#: crates/core/src/guide.rs
msgid "A standardised measure of the radiation output of the scanner for this scan, in milligray (mGy). It describes the scanner setting, not the dose an individual person received."
msgstr "Una medida estandarizada de la radiación que emitió el escáner en esta exploración, en miligray (mGy). Describe el ajuste del escáner, no la dosis que recibió una persona concreta."

#: crates/core/src/guide.rs
msgid "The mathematical filter used to compute the images, as named by the scanner. Sharp kernels show fine detail and edges; smooth kernels reduce grain."
msgstr "El filtro matemático usado para calcular las imágenes, con el nombre que le da el escáner. Los kernels nítidos muestran el detalle fino y los bordes; los suaves reducen el grano."

#: crates/core/src/guide.rs
msgid "The filter placed in the X-ray beam inside the scanner, as named by the manufacturer."
msgstr "El filtro colocado en el haz de rayos X dentro del escáner, con el nombre que le da el fabricante."

#: crates/core/src/guide.rs
msgid "How far the table moves during one turn of the X-ray tube, relative to the width of the X-ray beam. At 1 the turns of the spiral lie side by side without gap or overlap."
msgstr "Cuánto avanza la camilla durante una vuelta del tubo de rayos X, en relación con la anchura del haz. Con un valor de 1, las vueltas de la espiral quedan una junto a otra, sin huecos ni solapamientos."

#: crates/core/src/guide.rs
msgid "The time the X-ray tube needs for one turn around the body, in seconds (s)."
msgstr "El tiempo que necesita el tubo de rayos X para dar una vuelta alrededor del cuerpo, en segundos (s)."

#: crates/core/src/guide.rs
msgid "The width of the X-ray beam along the body, in millimetres (mm)."
msgstr "La anchura del haz de rayos X a lo largo del cuerpo, en milímetros (mm)."

#: crates/core/src/guide.rs
msgid "The diameter of the circular area that was computed into the image, in millimetres (mm)."
msgstr "El diámetro de la zona circular que se calculó para la imagen, en milímetros (mm)."

#: crates/core/src/guide.rs
msgid "The angle by which the scanner ring was tilted from the upright position, in degrees."
msgstr "El ángulo que se inclinó el anillo del escáner respecto a la posición vertical, en grados."

#: crates/core/src/guide.rs
msgid "The contrast agent recorded for this series. Contrast agents make vessels or certain tissues stand out in the images."
msgstr "El medio de contraste registrado para esta serie. Los medios de contraste hacen que los vasos o ciertos tejidos destaquen en las imágenes."

#: crates/core/src/guide.rs
msgid "The kind of equipment that made the images, for example CT (computed tomography) or MR (magnetic resonance)."
msgstr "El tipo de equipo que obtuvo las imágenes, por ejemplo CT (tomografía computarizada) o MR (resonancia magnética)."

#: crates/core/src/guide.rs
msgid "The body region entered at the scanner for this series. It is picked from a list by the operator and can be imprecise."
msgstr "La región del cuerpo introducida en el escáner para esta serie. El operador la elige de una lista y puede ser imprecisa."

#: crates/core/src/guide.rs
msgid "The name of the scan programme selected at the scanner. Hospitals choose these names themselves."
msgstr "El nombre del programa de exploración elegido en el escáner. Cada hospital elige estos nombres."

#: crates/core/src/guide.rs
msgid "The name given to this series at the scanner, usually an abbreviation of the technique and the direction of the slices."
msgstr "El nombre dado a esta serie en el escáner, normalmente una abreviatura de la técnica y de la dirección de los cortes."

#: crates/core/src/guide.rs
msgid "How the person lay in the scanner, for example head first and on the back."
msgstr "Cómo estaba acostada la persona en el escáner, por ejemplo entrando con la cabeza primero y boca arriba."

#: crates/core/src/guide.rs
msgid "The side of the body that was examined: R for right, L for left."
msgstr "El lado del cuerpo que se examinó: R (del inglés right) para el derecho y L (left) para el izquierdo."

#: crates/core/src/guide.rs
msgid "The number under which the hospital's information system filed this examination."
msgstr "El número con el que el sistema de información del hospital registró esta exploración."

#: crates/core/src/guide.rs
msgid "The number of this image within its series, as assigned by the scanner."
msgstr "El número de esta imagen dentro de su serie, asignado por el escáner."

#: crates/core/src/guide.rs
msgid "Codes describing how the image came about, for example ORIGINAL for a direct measurement or DERIVED for an image computed from others."
msgstr "Códigos que describen cómo se obtuvo la imagen, por ejemplo ORIGINAL para una medición directa o DERIVED para una imagen calculada a partir de otras."

#: crates/core/src/guide.rs
msgid "The number of picture points (pixels) across and down the image."
msgstr "El número de puntos de imagen (píxeles) a lo ancho y a lo alto de la imagen."

#: crates/core/src/guide.rs
msgid "The number of images stored together in this file."
msgstr "El número de imágenes guardadas juntas en este archivo."

#: crates/core/src/guide.rs
msgid "The size of the piece of the body that one pixel stands for, in millimetres (mm): across by down."
msgstr "El tamaño de la parte del cuerpo que representa un píxel, en milímetros (mm): ancho por alto."

#: crates/core/src/guide.rs
msgid "The width and height of the area of the body that the image covers, in millimetres (mm)."
msgstr "El ancho y el alto de la zona del cuerpo que abarca la imagen, en milímetros (mm)."

#: crates/core/src/guide.rs
msgid "The thickness of the layer of the body shown in one image, in millimetres (mm). Thinner slices show finer detail but look grainier."
msgstr "El grosor de la capa del cuerpo que muestra una imagen, en milímetros (mm). Los cortes más finos muestran más detalle, pero se ven más granulados."

#: crates/core/src/guide.rs
msgid "The distance from the middle of one slice to the middle of the next, in millimetres (mm). If it is larger than the slice thickness, there are gaps between the slices."
msgstr "La distancia del centro de un corte al centro del siguiente, en milímetros (mm). Si es mayor que el grosor de corte, hay huecos entre los cortes."

#: crates/core/src/guide.rs
msgid "The position of this slice along the scan direction, in millimetres (mm), counted from a reference point set by the scanner."
msgstr "La posición de este corte a lo largo de la dirección de exploración, en milímetros (mm), contada desde un punto de referencia fijado por el escáner."

#: crates/core/src/guide.rs
msgid "Where the first pixel of this image lies in the body, in millimetres (mm): towards the patient's left, towards the back and towards the head, counted from a reference point set by the scanner."
msgstr "Dónde está en el cuerpo el primer píxel de esta imagen, en milímetros (mm): hacia la izquierda del paciente, hacia la espalda y hacia la cabeza, contado desde un punto de referencia fijado por el escáner."

#: crates/core/src/guide.rs
msgid "The direction of the image through the body and the directions of its rows and columns. The letters stand for the patient's right (R), left (L), front (A), back (P), head (S) and feet (I)."
msgstr "La dirección de la imagen a través del cuerpo y las direcciones de sus filas y columnas. Las letras indican la derecha (R), la izquierda (L), la parte delantera (A), la espalda (P), la cabeza (S) y los pies (I) del paciente."

#: crates/core/src/guide.rs
msgid "How the stored numbers translate into grey levels or colours, for example MONOCHROME2: larger numbers are brighter."
msgstr "Cómo se traducen los números guardados en niveles de gris o en colores, por ejemplo MONOCHROME2: los números más altos son más claros."

#: crates/core/src/guide.rs
msgid "How many bits hold each pixel value, which limits the number of different grey levels: 12 bits allow 4096 levels."
msgstr "Cuántos bits contiene el valor de cada píxel, lo que limita el número de niveles de gris distintos: 12 bits permiten 4096 niveles."

#: crates/core/src/guide.rs
msgid "The rule that turns stored numbers into meaningful values: stored number times slope plus intercept. For CT the result is in Hounsfield units (HU), a density scale on which water is 0 and air is -1000."
msgstr "La regla que convierte los números guardados en valores con significado: número guardado por la pendiente más el intercepto. En TC el resultado está en unidades Hounsfield (HU), una escala de densidad en la que el agua es 0 y el aire, -1000."

#: crates/core/src/guide.rs
msgid "Brightness and contrast settings stored with the image by the scanner or its operator. C is the centre and W the width of the range of values shown from black to white."
msgstr "Ajustes de brillo y contraste guardados con la imagen por el escáner o su operador. C es el centro y W el ancho del rango de valores que se muestra de negro a blanco."

#: crates/core/src/guide.rs
msgid "Whether the image was compressed in a way that discards some detail to save space."
msgstr "Si la imagen se comprimió de una forma que descarta algo de detalle para ahorrar espacio."

#: crates/core/src/guide.rs
msgid "Whether the equipment wrote text, such as names or dates, into the picture itself. Such text is part of the image and cannot be hidden by this viewer."
msgstr "Si el equipo escribió texto, como nombres o fechas, en la propia imagen. Ese texto forma parte de la imagen y este visor no puede ocultarlo."

#: crates/core/src/guide.rs
msgid "The technical format in which the image data is stored in the file, including any compression."
msgstr "El formato técnico en que se guardan los datos de la imagen en el archivo, incluida la compresión, si la hay."

#: crates/core/src/guide.rs
msgid "The kind of DICOM object this file is, for example a CT image or a secondary capture, which is a stored picture."
msgstr "El tipo de objeto DICOM que es este archivo, por ejemplo una imagen de TC o una captura secundaria, que es una imagen guardada."

#: crates/core/src/guide.rs
msgid "A worldwide unique technical number of this examination. It has no medical meaning."
msgstr "Un número técnico único en todo el mundo para esta exploración. No tiene significado médico."

#: crates/core/src/guide.rs
msgid "A worldwide unique technical number of this series. It has no medical meaning."
msgstr "Un número técnico único en todo el mundo para esta serie. No tiene significado médico."

#: crates/core/src/guide.rs
msgid "A worldwide unique technical number of this image. It has no medical meaning."
msgstr "Un número técnico único en todo el mundo para esta imagen. No tiene significado médico."

#: crates/core/src/guide.rs
msgid "Images that share this number use the same coordinate system, so positions can be compared between them."
msgstr "Las imágenes que comparten este número usan el mismo sistema de coordenadas, por lo que sus posiciones se pueden comparar."

#: crates/core/src/guide.rs
msgid "The standardised uptake value (SUV) compares the amount of tracer in a spot with the amount there would be if the injected tracer were spread evenly through the whole body, so 1 is that average. It is computed from the weight, the injected dose and the times that staff entered at the scanner, so it is approximate and only as exact as those entries."
msgstr "El valor de captación estandarizado (SUV) compara la cantidad de trazador en un punto con la que habría si el trazador inyectado se repartiera por igual en todo el cuerpo; así, 1 es ese promedio. Se calcula a partir del peso, la dosis inyectada y las horas que el personal introdujo en el escáner, por lo que es aproximado y solo tan exacto como esos datos."

#: crates/core/src/guide.rs
msgid "The unit in which the scanner stored the values, for example BQML: becquerel per millilitre, the measured concentration of radioactivity."
msgstr "La unidad en la que el escáner guardó los valores, por ejemplo BQML: becquerelios por mililitro, la concentración de radiactividad medida."

#: crates/core/src/guide.rs
msgid "Corrections the scanner applied to the values, as short codes: for example ATTN for attenuation, the weakening of the signal inside the body, and DECY for the decay of the radioactivity."
msgstr "Correcciones que el escáner aplicó a los valores, como códigos cortos: por ejemplo ATTN para la atenuación, el debilitamiento de la señal dentro del cuerpo, y DECY para el decaimiento de la radiactividad."

#: crates/core/src/guide.rs
msgid "The moment to which the scanner corrected the values for the decay of the radioactivity: START means the start of the scan."
msgstr "El momento al que el escáner refirió la corrección del decaimiento de la radiactividad: START significa el inicio de la exploración."

#: crates/core/src/guide.rs
msgid "The amount of radioactivity injected, in megabecquerel (MBq, millions of decays per second), as entered by staff."
msgstr "La cantidad de radiactividad inyectada, en megabecquerelios (MBq, millones de desintegraciones por segundo), según la introdujo el personal."

#: crates/core/src/guide.rs
msgid "The time in which the radioactivity of the tracer falls to half, in seconds (s): about 110 minutes for fluorine-18."
msgstr "El tiempo en que la radiactividad del trazador se reduce a la mitad, en segundos (s): unos 110 minutos para el flúor-18."

#: crates/core/src/guide.rs
msgid "The time the tracer was injected, as entered by staff. The radioactivity decays between this time and the scan, which the uptake value takes into account."
msgstr "La hora en que se inyectó el trazador, según la introdujo el personal. La radiactividad decae entre esta hora y la exploración, algo que el valor de captación tiene en cuenta."

#: crates/core/src/guide.rs
msgid "The time the scanner recorded for this series; for a PET series, the moment its values refer to."
msgstr "La hora que el escáner registró para esta serie; en una serie PET, el momento al que se refieren sus valores."

#: crates/core/src/guide.rs
msgid "The tracer that was injected, as entered at the scanner, for example fluorodeoxyglucose (FDG), a form of sugar."
msgstr "El trazador que se inyectó, según se introdujo en el escáner, por ejemplo fluorodesoxiglucosa (FDG), una forma de azúcar."

#: crates/core/src/guide.rs
msgid "A window stored with the images by the scanner or its operator, usually the one intended for this series."
msgstr "Una ventana guardada con las imágenes por el escáner o su operador, normalmente la prevista para esta serie."

#: crates/core/src/guide.rs
msgid "A window computed from the brightness values of the images loaded so far: it shows almost all of them and ignores the extremes."
msgstr "Una ventana calculada a partir de los valores de brillo de las imágenes cargadas hasta ahora: muestra casi todos y descarta los extremos."

#: crates/core/src/guide.rs
msgid "A window from the smallest to the largest value in the series: nothing is clipped, but contrast is low."
msgstr "Una ventana del valor más bajo al más alto de la serie: no se recorta nada, pero el contraste es bajo."

#: crates/core/src/guide.rs
msgid "A built-in window for uptake values (SUV) from SUV 0 to its upper limit: a higher limit keeps differences between high values visible, a lower one shows low values more clearly."
msgstr "Una ventana predefinida para valores de captación (SUV), de SUV 0 a su límite superior: un límite más alto mantiene visibles las diferencias entre valores altos; uno más bajo muestra con más claridad los valores bajos."

#: crates/core/src/guide.rs
msgid "It spreads the grey scale over densities from {low} to {high} HU (Hounsfield units: air is -1000, water 0); everything outside that range is shown as black or white."
msgstr "Reparte la escala de grises entre densidades de {low} a {high} HU (unidades Hounsfield: el aire es -1000 y el agua, 0); todo lo que queda fuera de ese rango se muestra en negro o en blanco."

#: crates/core/src/guide.rs
msgid "It spreads the grey scale over values from {low} to {high} {unit}; everything outside that range is shown as black or white."
msgstr "Reparte la escala de grises entre valores de {low} a {high} {unit}; todo lo que queda fuera de ese rango se muestra en negro o en blanco."

#: crates/core/src/guide.rs
msgid "It spreads the grey scale over values from {low} to {high}; everything outside that range is shown as black or white."
msgstr "Reparte la escala de grises entre valores de {low} a {high}; todo lo que queda fuera de ese rango se muestra en negro o en blanco."

#: crates/core/src/guide.rs
msgid "A contrast table stored with the images by the equipment: it turns values into grey levels along a curve chosen for these images instead of a straight line. Adjusting the contrast by hand switches to an ordinary window."
msgstr "Una tabla de contraste guardada con las imágenes por el equipo: convierte los valores en niveles de gris según una curva elegida para estas imágenes en lugar de una línea recta. Al ajustar el contraste a mano, se pasa a una ventana normal."

#: crates/core/src/guide.rs
msgid "A narrow window around the density of brain tissue, so that small density differences inside the brain become visible."
msgstr "Una ventana estrecha en torno a la densidad del tejido cerebral, para que se vean pequeñas diferencias de densidad dentro del cerebro."

#: crates/core/src/guide.rs
msgid "A wider window for the head, in which the thin layer between the brain and the skull stays distinguishable from the bone."
msgstr "Una ventana más amplia para la cabeza, en la que la fina capa entre el cerebro y el cráneo se sigue distinguiendo del hueso."

#: crates/core/src/guide.rs
msgid "A very narrow window that exaggerates small density differences in brain tissue; the image looks grainy with it."
msgstr "Una ventana muy estrecha que exagera las pequeñas diferencias de densidad del tejido cerebral; con ella la imagen se ve granulada."

#: crates/core/src/guide.rs
msgid "A window for the soft tissues of the head and neck, such as muscles and glands."
msgstr "Una ventana para los tejidos blandos de la cabeza y el cuello, como músculos y glándulas."

#: crates/core/src/guide.rs
msgid "A very wide window centred on bone, so that fine bone structures, such as those of the ear, stay distinguishable."
msgstr "Una ventana muy amplia centrada en el hueso, para que las estructuras óseas finas, como las del oído, se sigan distinguiendo."

#: crates/core/src/guide.rs
msgid "A wide window centred on low densities, so that the air-filled lungs with their vessels and airways become visible."
msgstr "Una ventana amplia centrada en densidades bajas, para que se vean los pulmones llenos de aire con sus vasos y vías respiratorias."

#: crates/core/src/guide.rs
msgid "A window for the soft tissues in the middle of the chest, such as the heart and the large vessels; the lungs look black with it."
msgstr "Una ventana para los tejidos blandos del centro del tórax, como el corazón y los grandes vasos; con ella los pulmones se ven negros."

#: crates/core/src/guide.rs
msgid "A window for the soft tissues of the abdomen, such as the liver, the kidneys and the bowel."
msgstr "Una ventana para los tejidos blandos del abdomen, como el hígado, los riñones y el intestino."

#: crates/core/src/guide.rs
msgid "A narrow window around the density of the liver, so that small density differences inside it become visible."
msgstr "Una ventana estrecha en torno a la densidad del hígado, para que se vean pequeñas diferencias de densidad en su interior."

#: crates/core/src/guide.rs
msgid "A wide window centred on high densities, so that the outer shell and the inner structure of bones become visible."
msgstr "Una ventana amplia centrada en densidades altas, para que se vean la capa externa y la estructura interna de los huesos."

#: crates/core/src/guide.rs
msgid "A window centred above soft tissue, so that vessels filled with contrast agent stand out and stay distinguishable from bone."
msgstr "Una ventana centrada por encima del tejido blando, para que los vasos llenos de medio de contraste destaquen y se sigan distinguiendo del hueso."

#: crates/core/src/guide.rs
msgid "A standard CT window."
msgstr "Una ventana estándar de TC."

#: crates/core/src/guide.rs
msgid "You are looking from the feet towards the head."
msgstr "Está mirando desde los pies hacia la cabeza."

#: crates/core/src/guide.rs
msgid "You are looking from the head towards the feet."
msgstr "Está mirando desde la cabeza hacia los pies."

#: crates/core/src/guide.rs
msgid "You are looking from the front of the body towards the back."
msgstr "Está mirando desde la parte delantera del cuerpo hacia la parte trasera."

#: crates/core/src/guide.rs
msgid "You are looking from the back of the body towards the front."
msgstr "Está mirando desde la parte trasera del cuerpo hacia la parte delantera."

#: crates/core/src/guide.rs
msgid "You are looking from the patient's right side towards the left."
msgstr "Está mirando desde el lado derecho del paciente hacia el izquierdo."

#: crates/core/src/guide.rs
msgid "You are looking from the patient's left side towards the right."
msgstr "Está mirando desde el lado izquierdo del paciente hacia el derecho."

#: crates/core/src/guide.rs
msgid "The image is tilted: you are looking roughly from the feet towards the head."
msgstr "La imagen está inclinada: está mirando aproximadamente desde los pies hacia la cabeza."

#: crates/core/src/guide.rs
msgid "The image is tilted: you are looking roughly from the head towards the feet."
msgstr "La imagen está inclinada: está mirando aproximadamente desde la cabeza hacia los pies."

#: crates/core/src/guide.rs
msgid "The image is tilted: you are looking roughly from the front of the body towards the back."
msgstr "La imagen está inclinada: está mirando aproximadamente desde la parte delantera del cuerpo hacia la parte trasera."

#: crates/core/src/guide.rs
msgid "The image is tilted: you are looking roughly from the back of the body towards the front."
msgstr "La imagen está inclinada: está mirando aproximadamente desde la parte trasera del cuerpo hacia la parte delantera."

#: crates/core/src/guide.rs
msgid "The image is tilted: you are looking roughly from the patient's right side towards the left."
